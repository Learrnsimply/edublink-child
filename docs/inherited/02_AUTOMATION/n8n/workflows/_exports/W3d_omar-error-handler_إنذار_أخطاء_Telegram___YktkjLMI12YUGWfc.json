    {
      "id": "e2",
      "name": "Format Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// نفس نمط rs-aios Global Error Handler — HTML لـ Telegram\nconst wf = $json.workflow || {};\nconst ex = $json.execution || {};\nconst err = ex.error || {};\nconst esc = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst level = String(err.level || 'error');\nconst emoji = level === 'warning' ? '⚠️' : '🔴';\nconst msg = esc(String(err.message || '(مفيش رسالة)').slice(0, 300));\nconst desc = esc(String(err.description || '').slice(0, 200));\nconst node = esc(ex.lastNodeExecuted || 'غير معروف');\nconst when = new Date().toLocaleString('sv-SE', { timeZone: 'Africa/Cairo' }).slice(0, 16);\nconst text = `${emoji} <b>خطأ في ورشة Learn Simply</b>\\n\\n` +\n  `📦 <b>Workflow:</b> ${esc(wf.name)}\\n` +\n  `🧭 <b>النود اللي فشل:</b> ${node}\\n` +\n  `🕒 <b>الوقت (القاهرة):</b> ${when}\\n\\n` +\n  `<b>الرسالة:</b>\\n<pre>${msg}</pre>` +\n  (desc ? `\\n<b>تفاصيل:</b> ${desc}` : '') +\n  `\\n\\n🔗 ${esc(ex.url || ('https://n8n.learrnsimply.com/workflow/' + (wf.id || '')))}`;\nreturn { json: { text } };"
      }
    },
    {
      "id": "e3",
      "name": "Telegram Alert",

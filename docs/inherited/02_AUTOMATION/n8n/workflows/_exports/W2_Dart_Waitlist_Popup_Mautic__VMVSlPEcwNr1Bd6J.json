  "nodes": [
    {
      "id": "popup_webhook",
      "name": "Dart Popup Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        240,
        300
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "httpMethod": "POST",
        "path": "dart-waitlist-97ae34dfa856",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://learrnsimply.com,https://www.learrnsimply.com"
        }
      },
      "webhookId": "b8803386-bf93-4e3d-a784-2c14d8285664"
    },
    {
      "id": "validate_code",
      "name": "Validate & Build",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// W2: validate a Dart-waitlist popup submission and build a Mautic contact body.\n// Never throws — always emits exactly one item describing the outcome so the\n// Respond nodes can return clean JSON to the browser fetch().\nconst items = $input.all();\nconst root = (items[0] && items[0].json) ? items[0].json : {};\nconst b = (root.body && typeof root.body === 'object') ? root.body : root;\n\n// Honeypot: a hidden field real users never fill. Non-empty => bot => silent skip.\nconst honeypot = String(b.website || b.hp || '').trim();\nif (honeypot) {\n  return [{ json: { valid: false, success: true, statusCode: 200, message: 'ok' } }];\n}\n\nconst email = String(b.email || '').trim().toLowerCase();\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nif (!emailOk) {\n  return [{ json: { valid: false, success: false, statusCode: 400, message: 'من فضلك أدخل بريدًا إلكترونيًا صحيحًا' } }];\n}\n\nconst firstname = String(b.firstname || b.first_name || b.name || '').trim();\nconst contactBody = { email, tags: ['dart-waitlist'] };\nif (firstname) contactBody.firstname = firstname;\n\nreturn [{ json: { valid: true, success: true, statusCode: 200, email, firstname, contactBody } }];"
      }
    },
    {
      "id": "is_valid_if",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        680,

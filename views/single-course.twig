{% extends "layouts/base.twig" %}

{#
  صفحة الكورس — بنية Code with Mosh (MOSH-BLUEPRINT.md · الموجة د)
  عمود واحد · ١٣ كتلة بترتيب ثابت · السعر في الهيرو والـCTA الختامي والشريط اللاصق بس.
  هيرو ← مكانك في المسار ← عن الكورس ← هتتعلم إيه ← هتبني إيه ← المحتوى ← لمين
  ← المتطلب السابق واللي بعده ← المدرّس ← الآراء ← الأسئلة ← كمّل المسار ← CTA
  الأقسام اللي ملهاش داتا في كورس مبتظهرش فيه.
#}

{% block body_class %}learnsimply-course-body lsc-body{% endblock %}

{% block content %}
{% set sec = sections %}
<div class="lsc">

  {# ══ ١ · الهيرو ══ #}
  <section class="lsc-hero">
    <div class="lsc-wrap lsc-hero__grid">
      <div>
        <nav class="lsc-crumbs" aria-label="مسار التنقل">
          <a href="{{ site.url }}/courses/">الدورات</a>
          {% if path.label %}
            <span class="lsc-crumbs__sep">/</span><a href="{{ path.url ?: site.url ~ '/courses/' }}">{{ path.label }}</a>
            <span class="lsc-crumbs__sep">/</span><span class="lsc-step">الخطوة {{ path.position }} من {{ path.total }}</span>
          {% elseif is_free %}
            <span class="lsc-crumbs__sep">/</span><span class="lsc-step lsc-step--free">كورس مجاني</span>
          {% endif %}
        </nav>

        <h1 class="lsc-hero__title">{{ title }}</h1>
        {% if tagline %}<p class="lsc-hero__sub">{{ tagline }}</p>{% endif %}

        <div class="lsc-meta">
          {% if rating_count > 0 %}<span><span class="lsc-star">★</span> <b class="lsc-num">{{ rating_avg }}</b> <span class="lsc-num">({{ rating_count }} تقييم)</span></span>{% endif %}
          {% if students > 0 %}<span><b class="lsc-num">+{{ students|number_format(0, '.', ',') }}</b> طالب</span>{% endif %}
          {% if hours > 0 %}<span><b class="lsc-num">{{ hours }}</b> ساعة</span>{% endif %}
          <span><b class="lsc-num">{{ lesson_count }}</b> درس</span>
          <span class="lsc-level lsc-level--{{ level_key }}">{{ level }}</span>
        </div>

        <div class="lsc-hero__cta">
          {% if is_enrolled %}
            {% if lesson_url %}<a class="lsc-btn lsc-btn--primary lsc-btn--xl" href="{{ lesson_url }}">كمّل التعلم من حيث وقفت</a>{% endif %}
          {% elseif can_buy %}
            <a class="lsc-btn lsc-btn--primary lsc-btn--xl" href="{{ checkout_url }}">اشترك في الكورس <small class="lsc-num">· {{ price_label }} ج.م</small></a>
          {% elseif is_public and lesson_url %}
            <a class="lsc-btn lsc-btn--primary lsc-btn--xl" href="{{ lesson_url }}">ابدأ التعلم مجانًا</a>
          {% elseif is_user_logged_in %}
            <form method="POST" class="lsc-enroll">
              <input type="hidden" name="tutor_course_id" value="{{ course_id }}">
              <input type="hidden" name="tutor_course_action" value="_tutor_course_enroll_now">
              <input type="hidden" name="{{ tutor_nonce_field }}" value="{{ tutor_nonce }}">
              <button type="submit" class="lsc-btn lsc-btn--primary lsc-btn--xl">سجّل في الكورس مجانًا</button>
            </form>
          {% else %}
            <a class="lsc-btn lsc-btn--primary lsc-btn--xl" href="{{ site.url }}/dashboard/">سجّل في الكورس مجانًا</a>
          {% endif %}
          {% if not is_enrolled and preview_count > 0 and first_preview_url %}
            <a class="lsc-btn lsc-btn--ghost" href="{{ first_preview_url }}" target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              شاهد {{ preview_count }} دروس مجانية
            </a>
          {% endif %}
        </div>

        {% if not is_enrolled %}
          <p class="lsc-guarantee">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% if is_free %}مجاني بالكامل · وصول مدى الحياة{% else %}ضمان استرداد الفلوس خلال 7 أيام · وصول مدى الحياة بكل التحديثات{% endif %}
          </p>
          {% if bundle and can_buy %}
            <div class="lsc-bundle-hint">
              <span>{{ bundle.title }}: <b>{{ bundle.items|join(' + ') }}</b>{% if bundle.price_label %} بـ<b class="lsc-num">{{ bundle.price_label }} ج.م</b>{% endif %}</span>
              <a href="{{ bundle.url }}">شوف الباقة ←</a>
            </div>
          {% endif %}
        {% endif %}
      </div>

      <div class="lsc-media">
        {% if video %}
          {% if video.embed_url %}
            <iframe src="{{ video.embed_url }}" title="{{ title }}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
          {% elseif video.embed_code %}
            {{ video.embed_code|safe_embed }}
          {% elseif video.url %}
            <video controls playsinline preload="metadata" {% if video.poster %}poster="{{ video.poster }}"{% else %}poster="{{ image }}"{% endif %}>
              <source src="{{ video.url }}" type="video/mp4">
            </video>
          {% endif %}
        {% else %}
          <img src="{{ image }}" alt="{{ title }}" width="1024" height="576">
        {% endif %}
      </div>
    </div>
  </section>

  {# ══ ٢ · مكانك في المسار ══ #}
  {% if path.steps|length > 0 %}
  <section class="lsc-path" aria-labelledby="lsc-path-title">
    <div class="lsc-wrap">
      <div class="lsc-path__head">
        <div>
          <h2 id="lsc-path-title">مكانك في {{ path.label }}</h2>
          <p>
            {% if path.position == 1 %}ده أول كورس في المسار. ابدأ من هنا وكمّل بالترتيب.
            {% else %}الكورس ده بيبني على «{{ path.prereq.label }}»{% if path.next and not path.next.coming_soon %}، وبعده «{{ path.next.label }}»{% endif %}.{% endif %}
          </p>
        </div>
        {% if path.url %}<a href="{{ path.url }}">صفحة المسار كاملة ←</a>{% endif %}
      </div>
      <ol class="lsc-road" style="--lsc-steps:{{ path.total }}">
        {% for step in path.steps %}
        <li class="lsc-rstep {% if step.state %}lsc-rstep--{{ step.state }}{% endif %} {% if step.coming_soon %}lsc-rstep--soon{% endif %}">
          <span class="lsc-rstep__n lsc-num">{{ loop.index }}</span>
          {% if step.coming_soon %}
            <span class="lsc-rstep__card">
              <span class="lsc-rstep__img lsc-rstep__img--soon">Flutter</span>
              <span class="lsc-rstep__t">{{ step.label }}</span>
              <span class="lsc-rstep__m">قريبًا</span>
            </span>
          {% else %}
            <a class="lsc-rstep__card" href="{{ step.url }}" {% if step.state == 'now' %}aria-current="page"{% endif %}>
              <span class="lsc-rstep__img"><img src="{{ step.thumbnail ?: no_image_url }}" alt="" loading="lazy" width="360" height="203"></span>
              {% if step.state == 'now' %}<span class="lsc-rstep__tag">أنت هنا</span>{% elseif step.state == 'done' %}<span class="lsc-rstep__tag">قبله</span>{% endif %}
              <span class="lsc-rstep__t">{{ step.label }}</span>
              <span class="lsc-rstep__m">{{ [step.hours_label, step.level]|filter(v => v)|join(' · ') }}</span>
            </a>
          {% endif %}
        </li>
        {% endfor %}
      </ol>
    </div>
  </section>
  {% endif %}

  {# ══ ٣ · عن الكورس ══ #}
  {% if sec.about_html or sec.about|length > 0 %}
  <section class="lsc-sec" aria-labelledby="lsc-about-title">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">About</p>
      <h2 class="lsc-h2" id="lsc-about-title">عن الكورس</h2>
      <div class="lsc-prose">
        {% if sec.about_html %}
          {{ sec.about_html|safe_html }}
        {% else %}
          {% for p in sec.about %}<p>{{ p }}</p>{% endfor %}
        {% endif %}
        {% for p in sec.outcome %}<p class="lsc-prose__after">{{ p }}</p>{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ══ ٤ · هتتعلم إيه ══ #}
  {% if sec.learn_count > 0 %}
  <section class="lsc-sec" aria-labelledby="lsc-learn-title">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">What you'll learn</p>
      <h2 class="lsc-h2" id="lsc-learn-title">{{ sec.learn_title }}</h2>
      {% set grouped = sec.learn_groups|length > 1 or (sec.learn_groups|length == 1 and sec.learn_groups[0].title) %}
      <div class="{{ grouped ? 'lsc-learn' : 'lsc-learn lsc-learn--flat' }}">
        {% for g in sec.learn_groups %}
          {% if grouped %}
          <div class="lsc-lgroup">
            {% if g.title %}<h3><i></i>{{ g.title }}</h3>{% endif %}
            {% for t in g.items %}<div class="lsc-check">{% include 'components/icons/check.twig' %}<span>{{ t }}</span></div>{% endfor %}
          </div>
          {% else %}
            {% for t in g.items %}<div class="lsc-check">{% include 'components/icons/check.twig' %}<span>{{ t }}</span></div>{% endfor %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ══ ٥ · هتبني إيه ══ #}
  {% if extras.build_items|length > 0 %}
  <section class="lsc-sec" aria-labelledby="lsc-build-title">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">What you'll build</p>
      <h2 class="lsc-h2" id="lsc-build-title">هتبني إيه جوه الكورس؟</h2>
      <p class="lsc-lead">مش فيديوهات نظرية. كل درس بياخدك لخطوة تطبيقية هتضيفها لـPortfolio بتاعك.</p>
      {% set kind_labels = {'oop': 'OOP', 'backend': 'Backend', 'python': 'Projects', 'flutter': 'Flutter', 'mobile': 'Mobile'} %}
      <div class="lsc-build">
        {% for item in extras.build_items %}
        <article class="lsc-bcard">
          <div class="lsc-bcard__vis lsc-bcard__vis--{{ item.kind }}">
            {% if item.kind == 'code' %}
              <pre class="lsc-code">{{ item.code|safe_html }}</pre>
            {% else %}
              <span class="lsc-bcard__icon">{% include 'components/icons/build-' ~ item.kind ~ '.twig' ignore missing %}</span>
              <span class="lsc-bcard__kind">{{ kind_labels[item.kind]|default(item.kind) }}</span>
            {% endif %}
          </div>
          <div class="lsc-bcard__body">
            <span class="lsc-bcard__tag">{{ item.tag }}</span>
            <h3>{{ item.title }}</h3>
            <p>{{ item.desc }}</p>
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ══ ٦ · محتوى الكورس ══ #}
  {% if topics|length > 0 %}
  <section class="lsc-sec" aria-labelledby="lsc-curr-title" id="curriculum">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">Course content</p>
      <h2 class="lsc-h2" id="lsc-curr-title">محتوى الكورس</h2>
      <div class="lsc-curr">
        <div class="lsc-curr__tot">
          <span><b class="lsc-num">{{ units_count }}</b> وحدات</span>
          <span><b class="lsc-num">{{ lesson_count }}</b> درس</span>
          {% if hours > 0 %}<span><b class="lsc-num">{{ hours }}</b> ساعة فيديو</span>{% endif %}
          {% if is_enrolled %}<span class="lsc-curr__hint">اضغط على أي درس عشان تفتحه</span>{% endif %}
        </div>
        {% for topic in topics %}
        <details class="lsc-unit" {% if loop.first %}open{% endif %}>
          <summary>
            <span class="lsc-unit__n lsc-num">{{ '%02d'|format(loop.index) }}</span>
            <span class="lsc-unit__t">{{ topic.title }}</span>
            <span class="lsc-unit__c lsc-num">{{ topic.count }} درس</span>
            <svg class="lsc-unit__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <ol>
            {% for c in topic.contents %}
            <li class="{% if c.is_preview and not is_enrolled %}lsc-lesson--preview{% elseif not is_enrolled %}lsc-lesson--locked{% endif %}">
              {% if is_enrolled or (c.is_preview and c.url) %}
                <a href="{{ c.url }}" {% if not is_enrolled %}target="_blank" rel="noopener"{% endif %}>
              {% else %}
                <a href="#buy">
              {% endif %}
                {% if c.type == 'quiz' %}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 12l2 2 4-4"/></svg>
                {% elseif not is_enrolled and not c.is_preview %}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                {% else %}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                {% endif %}
                <span class="lsc-lesson__t">{{ c.title }}</span>
                {% if c.is_preview and not is_enrolled %}<span class="lsc-lesson__badge">معاينة مجانية</span>{% endif %}
                {% if c.duration %}<span class="lsc-lesson__d lsc-num">{{ c.duration }}</span>{% endif %}
              </a>
            </li>
            {% endfor %}
          </ol>
        </details>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ══ ٧ · لمين الكورس ══ #}
  {% if sec.audience|length > 0 %}
  <section class="lsc-sec" aria-labelledby="lsc-who-title">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">Who is this for</p>
      <h2 class="lsc-h2" id="lsc-who-title">الكورس ده ليك لو…</h2>
      {% if sec.audience|length == 1 and sec.audience[0]|length > 80 %}
        <p class="lsc-who__prose">{{ sec.audience[0] }}</p>
      {% else %}
        <div class="lsc-who">
          {% for t in sec.audience %}<div class="lsc-who__item">{% include 'components/icons/check.twig' %}<span>{{ t }}</span></div>{% endfor %}
        </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {# ══ ٨ · المتطلب السابق واللي بعده ══ #}
  {% if path.position > 0 or sec.requirements|length > 0 %}
  <section class="lsc-sec" aria-labelledby="lsc-prereq-title">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">Prerequisites</p>
      <h2 class="lsc-h2" id="lsc-prereq-title">{% if path.prereq or sec.requirements|length > 0 %}محتاج تعرف إيه قبله؟{% else %}مش محتاج أي خلفية{% endif %}</h2>
      <div class="lsc-prereq">
        <div class="lsc-pcard {% if not path.prereq and sec.requirements|length == 0 %}lsc-pcard--none{% endif %}">
          <span class="lsc-pcard__lbl">المتطلب السابق</span>
          {% if path.prereq %}
            <a class="lsc-pcard__course" href="{{ path.prereq.url }}">
              <img src="{{ path.prereq.thumbnail ?: no_image_url }}" alt="" width="104" height="59" loading="lazy">
              <span><b>{{ path.prereq.label }}</b><small>{{ [path.prereq.hours_label, path.prereq.level, 'الخطوة ' ~ (path.position - 1)]|filter(v => v)|join(' · ') }}</small></span>
            </a>
          {% elseif sec.requirements|length == 0 %}
            <span class="lsc-pcard__big">{% include 'components/icons/check.twig' %} لا يوجد. {% if path.position == 1 %}ده أول كورس في المسار.{% else %}ابدأ من غير أي خلفية.{% endif %}</span>
          {% endif %}
          {% if sec.requirements|length > 0 %}
            <ul class="lsc-pcard__list">{% for r in sec.requirements %}<li>{{ r }}</li>{% endfor %}</ul>
          {% elseif extras.faq_items|length > 0 and extras.faq_items[0].a %}
            <p>{{ extras.faq_items[0].a }}</p>
          {% endif %}
        </div>
        {% if path.next and not path.next.coming_soon %}
        <div class="lsc-pcard">
          <span class="lsc-pcard__lbl">الخطوة اللي بعده</span>
          <a class="lsc-pcard__course" href="{{ path.next.url }}">
            <img src="{{ path.next.thumbnail ?: no_image_url }}" alt="" width="104" height="59" loading="lazy">
            <span><b>{{ path.next.label }}</b><small>{{ [path.next.hours_label, path.next.level, 'الخطوة ' ~ (path.position + 1)]|filter(v => v)|join(' · ') }}</small></span>
          </a>
          <p>لما تخلص الكورس ده، ده الكورس اللي بيكمّل عليه مباشرة في نفس المسار.</p>
        </div>
        {% elseif path.next and path.next.coming_soon %}
        <div class="lsc-pcard lsc-pcard--none">
          <span class="lsc-pcard__lbl">الخطوة اللي بعده</span>
          <span class="lsc-pcard__big">{{ path.next.label }} · قريبًا</span>
          <p>الكورس ده هو الأساس اللي محتاجه قبل Flutter، وكورس Flutter جاي بعده مباشرة.</p>
        </div>
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ══ ٩ · المدرّس ══ #}
  {% if instructor %}
  <section class="lsc-sec" aria-labelledby="lsc-why-title">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">Your instructor</p>
      <h2 class="lsc-h2" id="lsc-why-title">ليه تتعلم معايا؟</h2>
      <div class="lsc-why">
        <div>
          <div class="lsc-why__me">
            <img src="{{ instructor.avatar }}" alt="" width="52" height="52" loading="lazy">
            <span><b>{{ instructor.name }}</b><small>{{ instructor_title|default('مهندس برمجيات') }} · مؤسس اتعلم ببساطة</small></span>
          </div>
          <p class="lsc-why__text">البرمجة مش صعبة، بس محدش شرحها ببساطة. بقالي +7 سنين بشرح جافا وهياكل البيانات لطلاب الحاسبات وللمبتدئين بنفس الطريقة: فكرة واحدة في كل درس، مثال مباشر، وتمرين تطبقه بإيدك.</p>
          <a class="lsc-link" href="{{ instructor.url }}">تعرّف عليّ أكتر ←</a>
        </div>
        <div class="lsc-stats">
          <div class="lsc-stat"><b>{{ stats.youtube }}</b><span>مشترك على يوتيوب</span></div>
          <div class="lsc-stat"><b>{{ stats.students }}</b><span>طالب على المنصة</span></div>
          <div class="lsc-stat"><b>{{ stats.views }}</b><span>مشاهدة للشروحات</span></div>
          <div class="lsc-stat"><b>{{ stats.experience }}</b><span>سنين خبرة في التدريس</span></div>
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  {# ══ ١٠ · الآراء + فورم التقييم للمشترك ══ #}
  {% if reviews|length > 0 or can_write_review %}
  <section class="lsc-sec" aria-labelledby="lsc-rev-title" id="reviews">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">Reviews</p>
      <h2 class="lsc-h2" id="lsc-rev-title">اللي جربوا قبلك قالوا إيه</h2>
      {% if rating_count > 0 %}
        <p class="lsc-lead"><span class="lsc-star">★</span> <b class="lsc-num lsc-lead__b">{{ rating_avg }}</b> من <span class="lsc-num">{{ rating_count }}</span> تقييم على المنصة، من طلاب اشتروا الكورس فعلًا.</p>
      {% endif %}
      {% if reviews|length > 0 %}
      <div class="lsc-reviews" id="lsc-reviews">
        {% for r in reviews %}
        <figure class="lsc-rev" {% if loop.index > 3 %}hidden data-more{% endif %}>
          <div class="lsc-rev__stars" aria-label="{{ r.rating }} من 5">{% for i in 1..5 %}<span class="{{ i <= r.rating ? 'is-on' : '' }}">★</span>{% endfor %}</div>
          <blockquote class="lsc-rev__text">{{ r.content }}</blockquote>
          <figcaption class="lsc-rev__who">
            <span class="lsc-rev__av" aria-hidden="true">{{ r.author|slice(0, 1) }}</span>
            <span><b>{{ r.author }}</b><small>{{ r.date|date('d/m/Y') }}{% if r.pending %} · قيد المراجعة{% endif %}</small></span>
          </figcaption>
        </figure>
        {% endfor %}
      </div>
      {% if reviews|length > 3 %}
        <button type="button" class="lsc-link lsc-more" data-more-btn>كل الـ{{ reviews|length }} تقييم ←</button>
      {% endif %}
      {% endif %}

      {% if can_write_review %}
      <div class="lsc-review-form" id="add-review">
        <h3>{% if user_review %}عدّل تقييمك{% else %}شاركنا رأيك في الكورس{% endif %}</h3>
        <form method="post" id="tutor-review-form">
          <input type="hidden" name="course_id" value="{{ course_id }}">
          <input type="hidden" name="review_id" value="{{ user_review.id|default('') }}">
          <input type="hidden" name="action" value="tutor_place_rating">
          <input type="hidden" name="{{ tutor_nonce_field }}" value="{{ tutor_nonce }}">
          <div class="lsc-stars-input" id="star-rating-input" role="radiogroup" aria-label="التقييم">
            {% for i in 1..5 %}<button type="button" class="lsc-stars-input__s {% if user_review and i <= user_review.rating %}is-on{% endif %}" data-rating="{{ i }}" aria-label="{{ i }} نجوم">★</button>{% endfor %}
            <input type="hidden" name="tutor_rating_gen_input" id="tutor_rating_gen_input" value="{{ user_review.rating|default(0) }}">
          </div>
          <textarea name="review" rows="4" placeholder="اكتب تقييمك هنا…">{{ user_review.content|default('') }}</textarea>
          <div class="lsc-review-form__row">
            <button type="submit" class="lsc-btn lsc-btn--primary submit-review-btn"><span>{% if user_review %}تحديث التقييم{% else %}إرسال التقييم{% endif %}</span></button>
            <p class="lsc-review-form__msg" id="review-message" hidden></p>
          </div>
        </form>
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {# ══ ١١ · الأسئلة ══ #}
  {% if extras.faq_items|length > 0 and not is_enrolled %}
  <section class="lsc-sec" aria-labelledby="lsc-faq-title">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">FAQ</p>
      <h2 class="lsc-h2" id="lsc-faq-title">أسئلة بتتسأل كتير</h2>
      <div class="lsc-faq">
        {% for f in extras.faq_items %}
        <details class="lsc-faq__i" {% if loop.first %}open{% endif %}>
          <summary class="lsc-faq__q">{{ f.q }}</summary>
          <p class="lsc-faq__a">{{ f.a }}</p>
        </details>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ══ ١٢ · كمّل المسار ══ #}
  {% if path.rest|length > 0 %}
  <section class="lsc-sec" aria-labelledby="lsc-next-title">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">Next in the path</p>
      <h2 class="lsc-h2" id="lsc-next-title">{% if path.position > 0 %}كمّل المسار{% else %}ابدأ مسار الأساسيات{% endif %}</h2>
      <p class="lsc-lead">{% if path.position > 0 %}الكورسات اللي بتيجي بعد ده في {{ path.label }}، بالترتيب.{% else %}لو عجبك الأسلوب، ده المسار اللي بيبني أساسك صح: جافا ← OOP ← هياكل البيانات.{% endif %}</p>
      <div class="lsc-grid3">
        {% for s in path.rest %}
        <article class="lsc-card">
          <a class="lsc-card__img" href="{{ s.url }}" aria-hidden="true" tabindex="-1"><img src="{{ s.thumbnail ?: no_image_url }}" alt="" loading="lazy" width="360" height="203"></a>
          <div class="lsc-card__body">
            <div class="lsc-card__row">
              <h3 class="lsc-card__t"><a href="{{ s.url }}">{{ s.label }}</a></h3>
              {% if s.hours_label %}<span class="lsc-hours lsc-num">{{ s.hours_label }}</span>{% endif %}
            </div>
            <span class="lsc-card__step">الخطوة {{ s.position }} في المسار</span>
            <div class="lsc-card__meta">
              <span class="lsc-level lsc-level--{{ s.level_key }}">{{ s.level }}</span>
              <span><span class="lsc-num">{{ s.lesson_count }}</span> درس</span>
              <span class="lsc-price">{% if s.is_free %}مجاني{% else %}<span class="lsc-num">{{ s.price_label }}</span><small>ج.م</small>{% endif %}</span>
            </div>
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ══ ١٣ · CTA ختامي ══ #}
  {% if can_buy %}
  <section class="lsc-cta" id="buy">
    <div class="lsc-wrap">
      <h2>خطوة واحدة تفصلك عن البداية</h2>
      <p>مش محتاج تجهز أي حاجة. اشترك دلوقتي وابدأ أول درس في دقيقتين.</p>
      <div class="lsc-cta__price lsc-num">{{ price_label }} <small>ج.م · مرة واحدة · مدى الحياة</small></div>
      <a class="lsc-btn lsc-btn--primary lsc-btn--xl" href="{{ checkout_url }}">اشترك في الكورس دلوقتي</a>
      <p class="lsc-guarantee lsc-guarantee--center">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        دفع آمن ببطاقتك أو محفظتك الإلكترونية · ضمان استرداد خلال 7 أيام
      </p>
    </div>
  </section>
  {% elseif not is_enrolled and is_free %}
  <section class="lsc-cta" id="buy">
    <div class="lsc-wrap">
      <h2>ابدأ دلوقتي، ببلاش</h2>
      <p>سجّل حسابك في دقيقة والكورس كله بيتفتحلك على طول.</p>
      <a class="lsc-btn lsc-btn--primary lsc-btn--xl" href="{{ lesson_url and is_public ? lesson_url : site.url ~ '/dashboard/' }}">سجّل في الكورس مجانًا</a>
    </div>
  </section>
  {% endif %}

</div>

{# الشريط اللاصق على الموبايل — لحظة الشرا بس #}
{% if can_buy %}
<div class="lsc-sticky">
  <b class="lsc-num">{{ price_label }} <small>ج.م</small></b>
  <a class="lsc-btn lsc-btn--primary" href="{{ checkout_url }}">اشترك في الكورس</a>
</div>
{% endif %}
{% endblock %}

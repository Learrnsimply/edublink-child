<!-- ===== START: Dart Course Offer Section ===== -->
<style>
.ls-dart-section{padding:0;direction:rtl;font-family:"IBM Plex Sans Arabic",sans-serif;background-color:var(--learnsimply-dark-bg)}
.ls-dart-section *,.ls-dart-section *::before,.ls-dart-section *::after{box-sizing:border-box}
/* Mid-page placement (after featured courses) — the old 110px top padding was only
   needed when this section sat first and had to clear the fixed header */
.ls-dart-section .learnsimply-section-container{max-width:1440px;margin:0 auto;padding:30px 16px 8px}
.ls-dart{position:relative;background:linear-gradient(135deg,#0b1026 0%,#141b3d 55%,#0d1220 100%);border:1px solid rgba(64,119,243,0.25);border-radius:24px;overflow:hidden;display:flex;align-items:center;gap:32px;padding:40px 44px}
.ls-dart-glow{position:absolute;border-radius:50%;filter:blur(110px);pointer-events:none}
.ls-dart-glow-1{width:380px;height:380px;background:#4077f3;opacity:0.18;top:-120px;left:-60px}
.ls-dart-glow-2{width:300px;height:300px;background:#01c2f3;opacity:0.10;bottom:-140px;right:-40px}
.ls-dart-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(64,119,243,0.05) 1px,transparent 1px),linear-gradient(90deg,rgba(64,119,243,0.05) 1px,transparent 1px);background-size:36px 36px;pointer-events:none;-webkit-mask-image:radial-gradient(ellipse at center,#000 30%,transparent 75%);mask-image:radial-gradient(ellipse at center,#000 30%,transparent 75%)}

/* ── Content (right side in RTL) ── */
.ls-dart-content{position:relative;z-index:1;flex:1 1 55%;min-width:0}
.ls-dart-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.3);border-radius:100px;padding:6px 18px;margin-bottom:14px;animation:ls-dart-badge-pulse 2s ease-in-out infinite}
.ls-dart-badge-text{color:#ff6b6b;font-size:13px;font-weight:600}
@keyframes ls-dart-badge-pulse{0%,100%{box-shadow:0 0 0 0 rgba(239,68,68,0.35)}50%{box-shadow:0 0 0 10px rgba(239,68,68,0)}}
.ls-dart-title{color:#fff;font-size:32px;font-weight:700;line-height:1.5;margin:0 0 8px}
.ls-dart-title span{background:linear-gradient(135deg,#5b9df9,#01c2f3);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.ls-dart-subtitle{color:#93a0c2;font-size:15px;line-height:1.8;margin:0 0 20px;max-width:520px}

/* ── Timer ── */
.ls-dart-timer-label-top{color:#8893b0;font-size:13px;margin:0 0 8px;display:flex;align-items:center;gap:6px}
.ls-dart-timer{display:flex;gap:10px;margin-bottom:22px}
.ls-dart-timer-box{background:rgba(64,119,243,0.1);border:1px solid rgba(64,119,243,0.25);border-radius:12px;padding:12px 6px;min-width:72px;text-align:center;transition:background .4s,border-color .4s}
.ls-dart-timer-num{color:#fff;font-size:28px;font-weight:700;line-height:1;margin-bottom:4px;font-variant-numeric:tabular-nums;transition:transform .3s,color .3s}
.ls-dart-timer-num.ls-dart-flip{animation:ls-dart-num-flip .4s ease-out}
@keyframes ls-dart-num-flip{0%{transform:translateY(-8px);opacity:.3}100%{transform:translateY(0);opacity:1}}
.ls-dart-timer-unit{color:#6b7394;font-size:11px}
.ls-dart-timer-box.ls-dart-urgent{background:rgba(239,68,68,0.1);border-color:rgba(239,68,68,0.35)}
.ls-dart-timer-box.ls-dart-urgent .ls-dart-timer-num{color:#ff6b6b}

/* ── Features ── */
.ls-dart-features{display:flex;gap:18px;flex-wrap:wrap;margin-bottom:22px}
.ls-dart-feature{display:flex;align-items:center;gap:7px;color:#c8cfe0;font-size:13px}
.ls-dart-feature svg{flex-shrink:0}

/* ── Price + CTA ── */
.ls-dart-price-row{display:flex;align-items:center;gap:14px;margin-bottom:20px;flex-wrap:wrap}
.ls-dart-price-new{color:#fff;font-size:34px;font-weight:700;line-height:1}
.ls-dart-price-new small{font-size:16px;font-weight:500;color:#93a0c2}
.ls-dart-price-old{color:#6b7394;font-size:18px;text-decoration:line-through}
.ls-dart-price-save{background:rgba(24,169,99,0.14);color:#2ecc80;font-size:13px;font-weight:600;padding:6px 14px;border-radius:8px;animation:ls-dart-save-pulse 2s ease-in-out infinite .5s}
@keyframes ls-dart-save-pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.06)}}
.ls-dart-actions{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.ls-dart-btn{display:inline-flex;align-items:center;gap:10px;background: linear-gradient(135deg, var(--ls-blue-cta, #3566d9) 0%, var(--ls-blue-cta-hover, #2a57bf) 100%);color:#fff;font-size:16px;font-weight:600;padding:15px 34px;border-radius:12px;text-decoration:none;position:relative;overflow:hidden;transition:transform .2s,box-shadow .2s;animation:ls-dart-btn-glow 2.5s ease-in-out infinite}
.ls-dart-btn:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(64,119,243,0.4);color:#fff;text-decoration:none}
.ls-dart-btn::after{content:'';position:absolute;top:0;left:-100%;width:60%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.18),transparent);animation:ls-dart-btn-shine 3s ease-in-out infinite}
@keyframes ls-dart-btn-glow{0%,100%{box-shadow:0 0 0 0 rgba(64,119,243,0)}50%{box-shadow:0 0 22px 4px rgba(64,119,243,0.35)}}
@keyframes ls-dart-btn-shine{0%{left:-100%}50%{left:120%}100%{left:120%}}
.ls-dart-spots{display:flex;align-items:center;gap:8px}
.ls-dart-spots-dot{width:6px;height:6px;border-radius:50%;background:#ef4444;animation:ls-dart-dot-blink 1.5s ease-in-out infinite}
@keyframes ls-dart-dot-blink{0%,100%{opacity:1}50%{opacity:.3}}
.ls-dart-spots-text{color:#ff6b6b;font-size:13px;font-weight:500}

/* ── Image (left side in RTL) ── */
.ls-dart-media{position:relative;z-index:1;flex:1 1 45%;min-width:0}
.ls-dart-media-inner{position:relative;border-radius:16px;overflow:hidden;border:1px solid rgba(64,119,243,0.35);box-shadow:0 20px 60px rgba(11,16,38,0.6),0 0 40px rgba(64,119,243,0.15);transform:rotate(-1.5deg);transition:transform .35s ease}
.ls-dart:hover .ls-dart-media-inner{transform:rotate(0deg) scale(1.015)}
.ls-dart-media-inner img{display:block;width:100%;height:auto}
.ls-dart-media-inner a{display:block}
.ls-dart-ribbon{position:absolute;top:14px;right:14px;z-index:2;background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;font-size:14px;font-weight:700;padding:7px 16px;border-radius:10px;box-shadow:0 6px 18px rgba(239,68,68,0.45);font-family:"IBM Plex Sans Arabic",sans-serif}

/* ── Responsive ── */
@media(max-width:1024px){
  .ls-dart{padding:32px 28px;gap:24px}
  .ls-dart-title{font-size:26px}
  .ls-dart-timer-box{min-width:62px}
  .ls-dart-timer-num{font-size:24px}
  .ls-dart-price-new{font-size:28px}
}
@media(max-width:820px){
  .ls-dart-section .learnsimply-section-container{padding:95px 14px 6px}
  .ls-dart{flex-direction:column-reverse;padding:24px 18px;gap:22px}
  .ls-dart-content{width:100%}
  .ls-dart-media{width:100%;max-width:480px;margin:0 auto}
  .ls-dart-media-inner{transform:rotate(0)}
  .ls-dart-title{font-size:22px}
  .ls-dart-subtitle{font-size:14px;margin-bottom:16px}
  .ls-dart-timer{gap:8px;justify-content:flex-start}
  .ls-dart-timer-box{min-width:0;flex:1;max-width:80px;padding:10px 4px}
  .ls-dart-timer-num{font-size:22px}
  .ls-dart-features{gap:12px;margin-bottom:18px}
  .ls-dart-price-new{font-size:26px}
  .ls-dart-actions{flex-direction:column;align-items:stretch}
  .ls-dart-btn{justify-content:center;width:100%}
  .ls-dart-spots{justify-content:center}
}
@media(max-width:480px){
  .ls-dart-section .learnsimply-section-container{padding:90px 12px 4px}
  .ls-dart{border-radius:18px;padding:20px 14px}
  .ls-dart-badge{padding:5px 12px}
  .ls-dart-badge-text{font-size:11px}
  .ls-dart-title{font-size:19px}
  .ls-dart-timer-num{font-size:20px}
  .ls-dart-timer-unit{font-size:10px}
  .ls-dart-price-old{font-size:15px}
  .ls-dart-price-save{font-size:11px;padding:4px 10px}
  .ls-dart-glow{width:220px;height:220px}
}
</style>

<section class="ls-dart-section">
  <div class="learnsimply-section-container">
    <div class="ls-dart">
      <div class="ls-dart-glow ls-dart-glow-1"></div>
      <div class="ls-dart-glow ls-dart-glow-2"></div>
      <div class="ls-dart-grid"></div>

      <div class="ls-dart-content">
        <div class="ls-dart-badge">
          <span>🔥</span>
          <span class="ls-dart-badge-text">خصم 50% — لفترة محدودة</span>
        </div>

        <h2 class="ls-dart-title">كورس <span>Dart</span> من الصفر للاحتراف</h2>
        <p class="ls-dart-subtitle">أول خطوة صح لبناء تطبيقات الموبايل بـ Flutter — هتتعلم لغة Dart من البداية لحد الـ OOP بشرح عربي بسيط ومشاريع عملية حقيقية.</p>

        <p class="ls-dart-timer-label-top">⏳ العرض بينتهي خلال:</p>
        <div class="ls-dart-timer" id="ls-dart-timer">
          <div class="ls-dart-timer-box">
            <div class="ls-dart-timer-num" id="ls-dart-days">00</div>
            <div class="ls-dart-timer-unit">يوم</div>
          </div>
          <div class="ls-dart-timer-box">
            <div class="ls-dart-timer-num" id="ls-dart-hours">00</div>
            <div class="ls-dart-timer-unit">ساعة</div>
          </div>
          <div class="ls-dart-timer-box">
            <div class="ls-dart-timer-num" id="ls-dart-mins">00</div>
            <div class="ls-dart-timer-unit">دقيقة</div>
          </div>
          <div class="ls-dart-timer-box">
            <div class="ls-dart-timer-num" id="ls-dart-secs">00</div>
            <div class="ls-dart-timer-unit">ثانية</div>
          </div>
        </div>

        <div class="ls-dart-features">
          <div class="ls-dart-feature">
            <svg width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M16.667 5L7.5 14.167 3.333 10" stroke="#2ecc80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>+20 ساعة شرح عربي</span>
          </div>
          <div class="ls-dart-feature">
            <svg width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M16.667 5L7.5 14.167 3.333 10" stroke="#2ecc80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>مشاريع وتحديات عملية</span>
          </div>
          <div class="ls-dart-feature">
            <svg width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M16.667 5L7.5 14.167 3.333 10" stroke="#2ecc80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>شهادة إتمام</span>
          </div>
          <div class="ls-dart-feature">
            <svg width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M16.667 5L7.5 14.167 3.333 10" stroke="#2ecc80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>وصول مدى الحياة</span>
          </div>
        </div>

        <div class="ls-dart-price-row">
          <span class="ls-dart-price-new">350 <small>ج.م</small></span>
          <span class="ls-dart-price-old">700 ج.م</span>
          <span class="ls-dart-price-save">وفّر 350 ج.م</span>
        </div>

        <div class="ls-dart-actions">
          <a class="ls-dart-btn" href="https://learrnsimply.com/courses/dart/">
            <span>اشترك في الكورس دلوقتي</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M13 8H3M7 4L3 8l4 4" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>

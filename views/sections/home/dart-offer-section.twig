          <a href="https://learrnsimply.com/courses/dart/" aria-label="كورس Dart من الصفر للاحتراف">
            <img src="https://learrnsimply.com/wp-content/uploads/2026/06/thumbnail-dart.png" alt="كورس Dart من الصفر إلى الاحتراف — أول خطوة لبناء تطبيقات الموبايل بـ Flutter" loading="eager" />
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
  (function(){
    var STORAGE_KEY = 'lsDartOfferDeadline';
    var WINDOW_MS = 48 * 60 * 60 * 1000; // 48 hours per visitor, renews when expired

    function getDeadline(){
      var stored = 0;
      try { stored = parseInt(localStorage.getItem(STORAGE_KEY), 10) || 0; } catch(e){}
      if (stored <= Date.now()) {
        stored = Date.now() + WINDOW_MS;
        try { localStorage.setItem(STORAGE_KEY, String(stored)); } catch(e){}
      }
      return stored;
    }

    var deadlineMs = getDeadline();
    function pad(n){ return String(n).padStart(2,'0'); }
    var prev = {d:'',h:'',m:'',s:''};

    function updateEl(id, val, key){
      var el = document.getElementById(id);
      if (!el || prev[key] === val) return;
      el.textContent = val;
      el.classList.remove('ls-dart-flip');
      void el.offsetWidth;
      el.classList.add('ls-dart-flip');
      prev[key] = val;
    }

    function tick(){
      var diff = deadlineMs - Date.now();
      if (diff <= 0) { deadlineMs = getDeadline(); diff = deadlineMs - Date.now(); }

      var d = pad(Math.floor(diff / 86400000));
      var h = pad(Math.floor((diff % 86400000) / 3600000));
      var m = pad(Math.floor((diff % 3600000) / 60000));
      var s = pad(Math.floor((diff % 60000) / 1000));

      updateEl('ls-dart-days', d, 'd');
      updateEl('ls-dart-hours', h, 'h');
      updateEl('ls-dart-mins', m, 'm');
      updateEl('ls-dart-secs', s, 's');

      var urgent = parseInt(d, 10) === 0;
      document.querySelectorAll('.ls-dart-timer-box').forEach(function(b){
        b.classList.toggle('ls-dart-urgent', urgent);
      });
    }

    tick();
    setInterval(tick, 1000);
  })();
  </script>
</section>
<!-- ===== END: Dart Course Offer Section ===== -->

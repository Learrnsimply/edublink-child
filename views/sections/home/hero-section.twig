    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const counters = document.querySelectorAll('.counter');
        const observerOptions = {
          threshold: 0.1,
          rootMargin: '0px'
        };

        const observer = new IntersectionObserver(function(entries) {
          entries.forEach(entry => {
            if (entry.isIntersecting && !entry.target.classList.contains('animated')) {
              entry.target.classList.add('animated');
              const target = parseInt(entry.target.getAttribute('data-target'));
              const element = entry.target;

              let current = 0;
              const increment = target / 50;
              const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                  element.textContent = target.toLocaleString('en-US');
                  clearInterval(timer);
                } else {
                  element.textContent = Math.floor(current).toLocaleString('en-US');
                }
              }, 30);
            }
          });
        }, observerOptions);

        counters.forEach(counter => observer.observe(counter));
      });
    </script>

    <!-- Smooth scroll for the "ابدأ الآن" CTA (stays on the same page) -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('[data-scroll-to]').forEach(function(link) {
          link.addEventListener('click', function(e) {
            var targetId = link.getAttribute('data-scroll-to');
            var target = document.getElementById(targetId);
            if (!target) return; // fall back to default anchor jump
            e.preventDefault();
            var offset = 20;
            var top = target.getBoundingClientRect().top + window.pageYOffset - offset;
            window.scrollTo({ top: top, behavior: 'smooth' });
          });
        });
      });
    </script>

    <!-- Countdown Timer Logic -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var banner = document.getElementById('dartPromoBanner');
        var countdown = document.getElementById('dartCountdown');
        if (!banner || !countdown) return;

        // Deadline: use data-deadline if set, otherwise a rolling 3-day window
        // persisted per-visitor in localStorage so it feels like a real offer.
        var deadline;
        var attr = (banner.getAttribute('data-deadline') || '').trim();
        if (attr) {
          deadline = new Date(attr).getTime();
        } else {
          var stored = localStorage.getItem('dartOfferDeadline');
          if (stored) {
            deadline = parseInt(stored, 10);
          } else {
            deadline = Date.now() + 3 * 24 * 60 * 60 * 1000; // 3 days
            localStorage.setItem('dartOfferDeadline', deadline);
          }
        }

        var nums = {};
        countdown.querySelectorAll('.countdown-num').forEach(function(el) {
          nums[el.getAttribute('data-unit')] = el;
        });

        function pad(n) { return (n < 10 ? '0' : '') + n; }

        function tick() {
          var diff = deadline - Date.now();
          if (diff <= 0) {
            // Offer ended — reset to a fresh window so the banner stays live.
            deadline = Date.now() + 3 * 24 * 60 * 60 * 1000;
            localStorage.setItem('dartOfferDeadline', deadline);
            diff = deadline - Date.now();
          }
          var days = Math.floor(diff / (1000 * 60 * 60 * 24));
          var hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          var minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
          var seconds = Math.floor((diff % (1000 * 60)) / 1000);
          if (nums.days) nums.days.textContent = pad(days);
          if (nums.hours) nums.hours.textContent = pad(hours);
          if (nums.minutes) nums.minutes.textContent = pad(minutes);
          if (nums.seconds) nums.seconds.textContent = pad(seconds);
        }

        tick();
        setInterval(tick, 1000);
      });
    </script>


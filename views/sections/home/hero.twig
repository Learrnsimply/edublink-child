{# الهيرو — النص الحالي للمنصة، من غير صور: كارت كود بيتكتب لوحده (assets/home/script.js) #}
<section class="lsh-hero" aria-labelledby="lsh-hero-title">
  <div class="lsh-wrap lsh-hero__grid">
    <div class="lsh-hero__copy">
      <h1 id="lsh-hero-title" class="lsh-hero__title">البرمجة أسهل ممــا تتخيل...<br>لو اتعلمتها <em>ببساطة</em></h1>
      <p class="lsh-hero__lead">ابدأ من الصفر، افهم الأساس صح، واشتغل بإيدك على مشاريع حقيقية من غير تعقيد.</p>
      <div class="lsh-hero__ctas">
        <a class="lsh-btn lsh-btn--primary lsh-btn--xl" href="{{ courses_archive_url|default(site.url ~ '/courses/') }}">ابدأ الآن</a>
      </div>
      <ul class="lsh-trust">
        <li>ضمان استرداد خلال 7 أيام</li>
        <li>شهادة إكمال لكل مستوى</li>
        <li>مشاريع تطبيقية عملية</li>
        <li>تمارين بعد كل درس</li>
      </ul>
      <div class="lsh-stats">
        <div><span class="lsh-stats__v lsh-num">{{ stats.youtube }}</span><span class="lsh-stats__k">متابع على يوتيوب</span></div>
        <div><span class="lsh-stats__v lsh-num">{{ stats.students_claim }}</span><span class="lsh-stats__k">طالب من {{ stats.countries_claim }} دولة</span></div>
        {% if stats.rating_avg %}
        <div><span class="lsh-stats__v lsh-num">{{ stats.rating_avg }} <span class="lsh-star">★</span></span><span class="lsh-stats__k">متوسط تقييم الكورسات</span></div>
        {% endif %}
      </div>
    </div>

    <div class="lsh-code" aria-label="درس مصغّر: كود بيتكتب وتحته شرح" data-lsh-typewriter>
      <div class="lsh-code__bar">
        <i></i><i></i><i></i>
        <div class="lsh-code__tabs" role="tablist" aria-label="اختار اللغة">
          <button type="button" class="lsh-code__tab is-active" role="tab" aria-selected="true" data-lsh-tab="java">Java</button>
          <button type="button" class="lsh-code__tab" role="tab" aria-selected="false" data-lsh-tab="oop">OOP</button>
          <button type="button" class="lsh-code__tab" role="tab" aria-selected="false" data-lsh-tab="cpp">C++</button>
          <button type="button" class="lsh-code__tab" role="tab" aria-selected="false" data-lsh-tab="dart">Dart</button>
          <button type="button" class="lsh-code__tab" role="tab" aria-selected="false" data-lsh-tab="python">Python</button>
        </div>
      </div>
      <pre class="lsh-code__pre" data-lsh-pre><span class="lsh-code__k">int</span> score = <span class="lsh-code__n">92</span>;
<span class="lsh-code__k">String</span> grade;
<span class="lsh-code__k">if</span> (score >= <span class="lsh-code__n">90</span>) {
    grade = <span class="lsh-code__s">"A"</span>;
} <span class="lsh-code__k">else</span> {
    grade = <span class="lsh-code__s">"B"</span>;
}
System.out.<span class="lsh-code__f">println</span>(<span class="lsh-code__s">"درجتك: "</span> + grade);</pre>
      <div class="lsh-code__notes" data-lsh-notes aria-live="polite"><span class="lsh-code__note">الطباعة: الكمبيوتر بيرد عليك في التيرمينال تحت.</span></div>
      <div class="lsh-code__out" data-lsh-out><b>▶ درجتك: A ✓</b> <span>مبروك، نجحت من أول محاولة</span></div>
    </div>
  </div>
</section>

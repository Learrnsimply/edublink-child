<!-- ===== START: Final CTA Section (آخر الصفحة — بعد الـ FAQ) ===== -->
<style>
.ls-final-section{direction:rtl;font-family:"IBM Plex Sans Arabic",sans-serif;background-color:var(--learnsimply-dark-bg);padding:30px 16px 70px}
.ls-final-section *,.ls-final-section *::before,.ls-final-section *::after{box-sizing:border-box}
.ls-final{position:relative;max-width:1100px;margin:0 auto;text-align:center;background:linear-gradient(160deg,rgba(64,119,243,0.16) 0%,var(--ls-surface, #141924) 55%);border:1px solid rgba(64,119,243,0.3);border-radius:24px;padding:56px 32px;overflow:hidden;display:flex;flex-direction:column;align-items:center;gap:18px}
/* حماية: الكونتينر يكون على حجم المحتوى بس — يلغي أي min-height/flex من ملفات تانية */
.ls-final{min-height:0 !important;height:auto !important;justify-content:flex-start !important}
.ls-final > *{flex:0 0 auto !important}
.ls-final-glow{position:absolute;width:420px;height:420px;border-radius:50%;background:var(--ls-blue, #4077f3);opacity:0.12;filter:blur(120px);top:-160px;left:50%;transform:translateX(-50%);pointer-events:none}
.ls-final > *:not(.ls-final-glow){position:relative;z-index:1}
.ls-final-title{color:var(--ls-text, #ffffff);font-size:clamp(26px,4.5vw,38px);font-weight:700;line-height:1.5;margin:0;max-width:700px}
.ls-final-title span{background:linear-gradient(135deg,#5b9df9,#01c2f3);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.ls-final-sub{color:#93a0c2;font-size:16px;line-height:1.9;margin:0;max-width:600px}
.ls-final-points{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin:4px 0}
.ls-final-point{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:30px;padding:8px 16px;font-size:13.5px;color:#c8cfe0}
.ls-final-point svg{flex-shrink:0}
.ls-final-actions{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:14px;margin-top:6px}
.ls-final-btn{display:inline-flex;align-items:center;gap:10px;background: linear-gradient(135deg, var(--ls-blue-cta, #3566d9) 0%, var(--ls-blue-cta-hover, #2a57bf) 100%);color:var(--ls-text, #ffffff) !important;font-size:18px;font-weight:700;padding:17px 46px;border-radius:14px;text-decoration:none !important;box-shadow:0 8px 28px rgba(64,119,243,0.35);transition:transform .2s,box-shadow .2s}
.ls-final-btn:hover{transform:translateY(-2px);box-shadow:0 12px 34px rgba(64,119,243,0.45)}
.ls-final-btn-ghost{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:var(--ls-text, #ffffff) !important;font-size:15px;font-weight:600;padding:15px 28px;border-radius:14px;text-decoration:none !important;transition:background .2s,border-color .2s}
.ls-final-btn-ghost:hover{background:rgba(64,119,243,0.1);border-color:rgba(64,119,243,0.35)}
.ls-final-guarantee{display:inline-flex;align-items:center;gap:8px;color:#2ecc80;font-size:14px;margin:2px 0 0}
@media screen and (max-width:768px){
  .ls-final{padding:38px 20px}
  .ls-final-btn,.ls-final-btn-ghost{width:100%;justify-content:center}
}
/* anchor jumps (#roadmap / #courses) لازم تنزل تحت الهيدر الثابت */
#roadmap,#courses{scroll-margin-top:100px}
</style>

<section class="ls-final-section">
  <div class="ls-final">
    <div class="ls-final-glow"></div>

    <h2 class="ls-final-title">وصلت لحد هنا؟ يبقى إنت فعلًا <span>جاهز تبدأ</span></h2>
    <p class="ls-final-sub">مش محتاج خبرة ولا كلية حاسبات — محتاج بس أول خطوة. المسار جاهز، الشرح بالعربي وببساطة، وإنت هتتعلم بإيدك خطوة بخطوة.</p>

    <div class="ls-final-points">
      <span class="ls-final-point">
        <svg width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M16.6666 5L7.49998 14.1667L3.33331 10" stroke="#18A963" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
        وصول مدى الحياة
      </span>
      <span class="ls-final-point">
        <svg width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M16.6666 5L7.49998 14.1667L3.33331 10" stroke="#18A963" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
        شهادة بعد كل كورس
      </span>
      <span class="ls-final-point">
        <svg width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M16.6666 5L7.49998 14.1667L3.33331 10" stroke="#18A963" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
        دعم ومتابعة مستمرة
      </span>
      <span class="ls-final-point">
        <svg width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M16.6666 5L7.49998 14.1667L3.33331 10" stroke="#18A963" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
        مشاريع عملية حقيقية
      </span>
    </div>

    <div class="ls-final-actions">
      <a href="{{ courses_archive_url }}" class="ls-final-btn">ابدأ رحلتك دلوقتي</a>
      <a href="#roadmap" class="ls-final-btn-ghost">شوف المسار المقترح الأول</a>
    </div>

    <p class="ls-final-guarantee">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z" stroke="#2ecc80" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="#2ecc80" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      ضمان استرداد الفلوس خلال 7 أيام — تجرب من غير أي مخاطرة
    </p>
  </div>
</section>
<!-- ===== END: Final CTA Section ===== -->

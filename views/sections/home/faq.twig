{# الأسئلة الشائعة — الخمسة الحاليين بالحرف، بـ<details> من غير جافاسكريبت #}
{% set faqs = [
  { q: 'أنا مبتدئ خالص، المنصة دي مناسبة ليا؟', a: 'أيوه بالظبط. المحتوى اتبنى أساساً للي بيبدأ من الصفر. مش هتحتاج أي خلفية سابقة.' },
  { q: 'فيه كورسات مجانية؟', a: 'أيوه. فيه محتوى مجاني تقدر تبدأ بيه وتحس بأسلوب الشرح قبل ما تقرر أي حاجة.' },
  { q: 'نظام الدفع بيشتغل إزاي؟', a: 'بتدفع مرة واحدة بس للكورس اللي عايزه، ومفيش اشتراك شهري أو رسوم تانية. الكورس بيفضل معاك للأبد. ولو مش مناسبك، استرجاع كامل خلال 7 أيام.' },
  { q: 'هل هلاقي دعم لو واجهت مشكلة؟', a: 'أيوه. في مجتمع متعلمين نشط وتقدر تسأل وتتفاعل في أي وقت، ومش هتكون لوحدك في الرحلة.' },
  { q: 'هل هاخد شهادة بعد ما أخلص الكورس؟', a: 'أيوه. كل كورس بيتنهي بشهادة إتمام تقدر تحطها في CV أو LinkedIn بتاعك.' }
] %}
<section class="lsh-section" id="faq" aria-labelledby="lsh-faq-title">
  <div class="lsh-wrap">
    <p class="lsh-eyebrow">FAQ</p>
    <h2 id="lsh-faq-title" class="lsh-h2">اهم الاسئلة الشائعة</h2>
    <p class="lsh-sub">إجابات سريعة على أكثر الأسئلة التي تهمك قبل البدء.</p>
    <div class="lsh-faq">
      {% for item in faqs %}
      <details class="lsh-faq__item"{% if loop.first %} open{% endif %}>
        <summary class="lsh-faq__q">{{ item.q }}</summary>
        <p class="lsh-faq__a">{{ item.a }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

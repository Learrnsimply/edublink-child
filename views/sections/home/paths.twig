{# «تايه مش عارف تبدأ إزاي؟» — مسارين + باقة جميع الدورات. الخطوات من inc/academy-structure.php #}
<section class="lsh-section" id="paths" aria-labelledby="lsh-paths-title">
  <div class="lsh-wrap">
    <p class="lsh-eyebrow">Learning paths</p>
    <h2 id="lsh-paths-title" class="lsh-h2">تايه مش عارف تبدأ إزاي؟</h2>
    <p class="lsh-sub">لو هدفك تفهم البرمجة بجد وتبني أساس قوي للانترفيوهات وحل المشكلات، ابدأ بالمسار ده خطوة بخطوة.</p>

    <div class="lsh-paths">
      {% for path in paths %}
      <div class="lsh-path">
        <div class="lsh-path__head">
          <div>
            <p class="lsh-path__label">{{ path.label }}</p>
            <h3 class="lsh-path__title">{{ path.title }}</h3>
          </div>
          <a class="lsh-btn {{ path.primary ? 'lsh-btn--primary' : 'lsh-btn--ghost' }} lsh-btn--sm" href="{{ path.url }}">{{ path.cta }} ←</a>
        </div>
        <p class="lsh-path__text">{{ path.text }}</p>
        <ol class="lsh-steps lsh-steps--{{ path.steps|length }}">
          {% for step in path.steps %}
          <li class="lsh-step{% if step.coming_soon %} lsh-step--soon{% endif %}">
            {% if step.coming_soon %}
              <span class="lsh-step__img lsh-step__img--soon">{{ step.title }}</span>
            {% else %}
              <a href="{{ step.url }}" class="lsh-step__img" aria-hidden="true" tabindex="-1"><img src="{{ step.thumbnail }}" alt="" loading="lazy" width="320" height="180"></a>
            {% endif %}
            <span class="lsh-step__n lsh-num">{{ loop.index }}</span>
            <b class="lsh-step__title">{% if step.url %}<a href="{{ step.url }}">{{ step.title }}</a>{% else %}{{ step.title }}{% endif %}</b>
            <small class="lsh-step__meta">{{ step.meta }}</small>
          </li>
          {% endfor %}
        </ol>
      </div>
      {% endfor %}
    </div>

    {% if bundles %}
    <div class="lsh-bundles" id="bundle">
      <div class="lsh-bundles__head">
        <p class="lsh-eyebrow">Bundles</p>
        <h3 class="lsh-bundles__title">خُد المسار كله في باقة واحدة</h3>
        <p class="lsh-bundles__sub">كل باقة بتفتحلك كورسات المسار مع بعض، بسعر واحد، واسترجاع كامل خلال 7 أيام.</p>
      </div>
      <div class="lsh-bundles__grid">
        {% for bundle in bundles %}
        <article class="lsh-bcard{% if bundle.featured %} lsh-bcard--featured{% endif %}">
          <a class="lsh-bcard__img" href="{{ bundle.url }}" aria-hidden="true" tabindex="-1"><img src="{{ bundle.thumbnail }}" alt="" loading="lazy" width="640" height="360"></a>
          <div class="lsh-bcard__body">
            <p class="lsh-bcard__label">{{ bundle.label }}</p>
            <h4 class="lsh-bcard__title"><a href="{{ bundle.url }}">{{ bundle.title }}</a></h4>
            {% if bundle.items %}
            <ul class="lsh-bcard__items">
              {% for name in bundle.items %}<li>{{ name }}</li>{% endfor %}
            </ul>
            {% endif %}
            <p class="lsh-bcard__meta">
              <span><span class="lsh-num">{{ bundle.courses_count }}</span> {{ bundle.courses_count == 2 ? 'كورسين' : 'كورسات' }}</span>
              {% if bundle.hours_total %}<span>· <span class="lsh-num">{{ bundle.hours_total }}</span> ساعة</span>{% endif %}
              {% if bundle.lessons_total %}<span>· <span class="lsh-num">{{ bundle.lessons_total }}</span> درس</span>{% endif %}
            </p>
            <div class="lsh-bcard__buy">
              {% if bundle.price_label %}<span class="lsh-bcard__price"><span class="lsh-num">{{ bundle.price_label }}</span><small>ج.م · مرة واحدة</small></span>{% endif %}
              <a class="lsh-btn {{ bundle.featured ? 'lsh-btn--primary' : 'lsh-btn--ghost' }} lsh-btn--sm" href="{{ bundle.url }}">امتلك الباقة</a>
            </div>
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
</section>

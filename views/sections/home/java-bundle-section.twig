<!-- ===== START: Java Full-Path Bundle Section ===== -->
{% set jb = java_bundle %}
{% set jb_items = (jb.items is defined and jb.items|length > 0) ? jb.items : [
  { title: 'جافا الأساسيات', regular_price: 0, thumbnail: '' },
  { title: 'جافا OOP', regular_price: 0, thumbnail: '' },
  { title: 'هياكل البيانات — المستوى الأول', regular_price: 0, thumbnail: '' },
  { title: 'هياكل البيانات — المستوى الثاني', regular_price: 0, thumbnail: '' },
  { title: 'كورس دارت', regular_price: 0, thumbnail: '' },
  { title: 'مشاريع بايثون للمبتدئين', regular_price: 0, thumbnail: '' }
] %}
{% set jb_price = jb.price|default(1900) %}
{% set jb_total = jb.regular_total|default(0) %}
{% set jb_savings = jb.savings|default(0) %}
{% set jb_pct = jb.savings_percent|default(0) %}
{% set jb_ids = (jb.product_ids is defined) ? jb.product_ids|join(',') : '' %}

<style>
  .ls-jbundle-section{padding:26px 0 34px;direction:rtl;font-family:"IBM Plex Sans Arabic",sans-serif;background-color:var(--learnsimply-dark-bg,#0b0f17)}
  .ls-jbundle-section *,.ls-jbundle-section *::before,.ls-jbundle-section *::after{box-sizing:border-box}
  .ls-jbundle-container{max-width:1180px;margin:0 auto;padding:0 20px}

  .ls-jbundle-card{position:relative;background:linear-gradient(150deg,#0e1730 0%,#111a38 45%,#0c1122 100%);border:1px solid rgba(64,119,243,0.28);border-radius:28px;overflow:hidden;padding:44px 40px 40px}
  .ls-jbundle-glow{position:absolute;border-radius:50%;filter:blur(120px);pointer-events:none;z-index:0}
  .ls-jbundle-glow-1{width:420px;height:420px;background:#4077f3;opacity:0.22;top:-160px;right:-80px}
  .ls-jbundle-glow-2{width:340px;height:340px;background:#18A963;opacity:0.12;bottom:-160px;left:-70px}
  .ls-jbundle-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(64,119,243,0.05) 1px,transparent 1px),linear-gradient(90deg,rgba(64,119,243,0.05) 1px,transparent 1px);background-size:38px 38px;-webkit-mask-image:radial-gradient(ellipse at 50% 0%,#000 25%,transparent 72%);mask-image:radial-gradient(ellipse at 50% 0%,#000 25%,transparent 72%);pointer-events:none;z-index:0}
  .ls-jbundle-inner{position:relative;z-index:1}

  /* Header */
  .ls-jbundle-head{text-align:center;margin-bottom:30px}
  .ls-jbundle-badge{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,rgba(240,160,48,0.16),rgba(240,160,48,0.06));border:1px solid rgba(240,160,48,0.4);border-radius:100px;padding:7px 18px;font-size:13.5px;font-weight:700;color:#f7b955;margin-bottom:18px;letter-spacing:.2px}
  .ls-jbundle-title{font-size:34px;font-weight:800;line-height:1.4;color:#fff;margin:0 0 12px;letter-spacing:-0.4px}
  .ls-jbundle-title span{background:linear-gradient(120deg,#5b9df9,#18d08a);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:#5b9df9}
  .ls-jbundle-subtitle{font-size:16px;color:#9aa6c2;line-height:1.8;margin:0 auto;max-width:620px}
  .ls-jbundle-subtitle b{color:#18d08a;font-weight:700}

  /* Courses grid */
  .ls-jbundle-courses{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:30px 0}
  .ls-jbundle-course{background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:16px;overflow:hidden;transition:transform .28s ease,border-color .28s ease,box-shadow .28s ease}
  .ls-jbundle-course:hover{transform:translateY(-5px);border-color:rgba(64,119,243,0.4);box-shadow:0 16px 34px rgba(0,0,0,0.4)}
  .ls-jbundle-course-img{position:relative;width:100%;aspect-ratio:16/10;overflow:hidden;background:linear-gradient(135deg,#1a2744,#0d1832)}
  .ls-jbundle-course-img img{width:100%;height:100%;object-fit:cover;display:block}
  .ls-jbundle-course-num{position:absolute;top:10px;right:10px;width:26px;height:26px;border-radius:50%;background:rgba(64,119,243,0.95);color:#fff;font-size:13px;font-weight:800;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.35)}
  .ls-jbundle-course-body{padding:13px 14px 15px}
  .ls-jbundle-course-title{font-size:14px;font-weight:600;color:#e6ebf5;line-height:1.5;margin:0 0 9px;min-height:42px;display:flex;align-items:flex-start}
  .ls-jbundle-course-price{display:flex;align-items:center;gap:7px}
  .ls-jbundle-course-price .val{font-size:15px;font-weight:800;color:#fff}
  .ls-jbundle-course-price .cur{font-size:12px;color:#8893b0;font-weight:600}
  .ls-jbundle-course-price .sep{color:#54607f;font-size:12px}
  .ls-jbundle-course-price .tag{font-size:11px;color:#7f8aa6;text-decoration:line-through}

  /* Value / price summary */
  .ls-jbundle-summary{display:flex;align-items:stretch;gap:18px;flex-wrap:wrap;justify-content:center;margin:6px 0 28px}
  .ls-jbundle-sumbox{flex:1 1 200px;max-width:280px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:16px;padding:18px 22px;text-align:center}
  .ls-jbundle-sumbox.total .amount{color:#8893b0;text-decoration:line-through;text-decoration-thickness:2px}
  .ls-jbundle-sumbox.price{background:linear-gradient(150deg,rgba(64,119,243,0.16),rgba(24,169,99,0.08));border-color:rgba(64,119,243,0.4)}
  .ls-jbundle-sumbox.save{background:rgba(24,169,99,0.1);border-color:rgba(24,169,99,0.32)}
  .ls-jbundle-sumbox .label{font-size:12.5px;color:#8893b0;font-weight:600;margin-bottom:8px}
  .ls-jbundle-sumbox .amount{font-size:26px;font-weight:900;color:#fff;line-height:1;font-variant-numeric:tabular-nums}
  .ls-jbundle-sumbox .amount small{font-size:14px;font-weight:600;color:inherit;opacity:.8}
  .ls-jbundle-sumbox.price .amount{color:#fff}
  .ls-jbundle-sumbox.save .amount{color:#2ee08c}
  .ls-jbundle-sumbox .pct{display:inline-block;margin-top:8px;background:rgba(24,169,99,0.16);color:#2ee08c;font-size:12px;font-weight:800;padding:3px 10px;border-radius:50px}

  /* Actions */
  .ls-jbundle-actions{text-align:center}
  .ls-jbundle-btn{display:inline-flex;align-items:center;justify-content:center;gap:11px;background:linear-gradient(135deg,#4077f3,#2563eb);color:#fff;font-size:19px;font-weight:800;padding:18px 56px;border-radius:14px;text-decoration:none;border:none;cursor:pointer;position:relative;overflow:hidden;transition:transform .22s,box-shadow .22s;box-shadow:0 14px 34px rgba(64,119,243,0.42)}
  .ls-jbundle-btn:hover{transform:translateY(-3px);box-shadow:0 20px 46px rgba(64,119,243,0.55);color:#fff;text-decoration:none}
  .ls-jbundle-btn::after{content:'';position:absolute;top:0;left:-100%;width:55%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.22),transparent);animation:ls-jb-shine 3.2s ease-in-out infinite}
  @keyframes ls-jb-shine{0%{left:-100%}55%{left:130%}100%{left:130%}}
  .ls-jbundle-btn.is-loading{opacity:.75;pointer-events:none}
  .ls-jbundle-btn svg{transition:transform .25s}
  .ls-jbundle-btn:hover svg{transform:translateX(-5px)}
  .ls-jbundle-secondary{display:inline-flex;align-items:center;gap:7px;margin-top:16px;color:#9aa6c2;font-size:14.5px;font-weight:500;text-decoration:none;transition:color .2s;cursor:pointer;background:none;border:none;font-family:inherit}
  .ls-jbundle-secondary:hover{color:#fff}
  .ls-jbundle-secondary .up{color:#f7b955}

  /* Trust */
  .ls-jbundle-trust{display:flex;align-items:center;justify-content:center;gap:26px;flex-wrap:wrap;margin-top:26px;padding-top:22px;border-top:1px solid rgba(255,255,255,0.07)}
  .ls-jbundle-trust-item{display:flex;align-items:center;gap:8px;color:#aab3c9;font-size:13.5px;font-weight:500}
  .ls-jbundle-trust-item svg{flex-shrink:0}

  /* Responsive */
  @media(max-width:900px){
    .ls-jbundle-courses{grid-template-columns:repeat(2,1fr)}
    .ls-jbundle-title{font-size:27px}
    .ls-jbundle-card{padding:34px 24px 32px;border-radius:22px}
  }
  @media(max-width:560px){
    .ls-jbundle-courses{grid-template-columns:repeat(2,1fr);gap:12px}
    .ls-jbundle-title{font-size:22px}
    .ls-jbundle-subtitle{font-size:14.5px}
    .ls-jbundle-course-title{font-size:13px;min-height:38px}
    .ls-jbundle-summary{gap:12px}
    .ls-jbundle-sumbox{padding:14px 16px;flex:1 1 100%;max-width:100%}
    .ls-jbundle-btn{width:100%;font-size:17px;padding:16px 28px}
    .ls-jbundle-trust{gap:14px}
    .ls-jbundle-card{padding:26px 16px 26px}
  }
</style>

<section id="java-bundle" class="ls-jbundle-section">
  <div class="ls-jbundle-container">
    <div class="ls-jbundle-card">
      <span class="ls-jbundle-glow ls-jbundle-glow-1"></span>
      <span class="ls-jbundle-glow ls-jbundle-glow-2"></span>
      <span class="ls-jbundle-grid-bg"></span>

      <div class="ls-jbundle-inner">

        <div class="ls-jbundle-head">
          <div class="ls-jbundle-badge">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M20 12v9H4v-9M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z" stroke="#f7b955" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>الأكثر قيمة — خُد رحلة البرمجة كاملة</span>
          </div>
          <h2 class="ls-jbundle-title">بدل ما تشتري كورس كورس، <span>خُد الـ 6 كورسات مع بعض</span></h2>
          <p class="ls-jbundle-subtitle">
            رحلة البرمجة كاملة من الأساسيات لهياكل البيانات في باقة واحدة —
            {% if jb_savings > 0 %}توفّر <b>{{ jb_savings|number_format(0, '.', ',') }} ج.م</b> عن شرائهم بشكل منفصل.{% else %}كل اللي محتاجه عشان تبني أساس برمجي قوي.{% endif %}
          </p>
        </div>

        <!-- 4 course cards with real thumbnails + original prices -->
        <div class="ls-jbundle-courses">
          {% for item in jb_items %}
          <div class="ls-jbundle-course">
            <div class="ls-jbundle-course-img">
              {% if item.thumbnail %}<img src="{{ item.thumbnail }}" alt="{{ item.title }}" loading="lazy">{% endif %}
              <span class="ls-jbundle-course-num">{{ loop.index }}</span>
            </div>
            <div class="ls-jbundle-course-body">
              <p class="ls-jbundle-course-title">{{ item.title }}</p>
              <div class="ls-jbundle-course-price">
                {% if item.regular_price > 0 %}
                  <span class="val">{{ item.regular_price|number_format(0, '.', ',') }}</span>
                  <span class="cur">ج.م</span>
                {% else %}
                  <span class="cur">ضمن الباقة</span>
                {% endif %}
              </div>
            </div>
          </div>
          {% endfor %}
        </div>

        <!-- Price summary -->
        <div class="ls-jbundle-summary">
          {% if jb_total > 0 %}
          <div class="ls-jbundle-sumbox total">
            <div class="label">لو اشتريتهم منفصلين</div>
            <div class="amount">{{ jb_total|number_format(0, '.', ',') }} <small>ج.م</small></div>
          </div>
          {% endif %}

          <div class="ls-jbundle-sumbox price">
            <div class="label">سعر الباقة كاملة</div>
            <div class="amount">{{ jb_price|number_format(0, '.', ',') }} <small>ج.م</small></div>
          </div>

          {% if jb_savings > 0 %}
          <div class="ls-jbundle-sumbox save">
            <div class="label">إنت بتوفّر</div>
            <div class="amount">{{ jb_savings|number_format(0, '.', ',') }} <small>ج.م</small></div>
            {% if jb_pct > 0 %}<span class="pct">وفّر {{ jb_pct }}%</span>{% endif %}
          </div>
          {% endif %}
        </div>

        <!-- Actions -->
        <div class="ls-jbundle-actions">
          <a class="ls-jbundle-btn" href="{{ site.url }}/course-bundle/allcourse/">
            <span class="ls-jbundle-btn-label">اشترك في الباقة كاملة</span>
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <div>
            <button type="button" class="ls-jbundle-secondary" data-scroll-to="courses">
              أو اشترِ أي كورس بمفرده من تحت <span class="up">↓</span>
            </button>
          </div>
        </div>

        <!-- Trust -->
        <div class="ls-jbundle-trust">
          <div class="ls-jbundle-trust-item">
            <svg width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M16.667 5L7.5 14.167 3.333 10" stroke="#18A963" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>ضمان استرداد خلال 7 أيام</span>
          </div>
          <div class="ls-jbundle-trust-item">
            <svg width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M16.667 5L7.5 14.167 3.333 10" stroke="#18A963" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>وصول مدى الحياة</span>
          </div>
          <div class="ls-jbundle-trust-item">
            <svg width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M16.667 5L7.5 14.167 3.333 10" stroke="#18A963" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>6 كورسات في باقة واحدة</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- ===== END: Java Full-Path Bundle Section ===== -->

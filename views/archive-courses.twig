{% extends "layouts/base.twig" %}

{% block title %}{{ archive_title }} - {{ site.name }}{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="{{ theme_uri }}/assets/course_archive/style.css" />
{% endblock %}

{% block head_extra %}
  <style>
    /* Course Info Icons Fix - Using absolute path */
    .learnsimply-courses-grid .course-info .info-item:first-child .info-icon,
    .learnsimply-courses-grid .course-info .info-item.level .info-icon,
    .course-card .course-info .info-item:first-child .info-icon,
    .course-card .course-info .info-item.level .info-icon {
      display: none !important;
    }

    .learnsimply-courses-grid .course-info .info-item:first-child::before,
    .learnsimply-courses-grid .course-info .info-item.level::before,
    .course-card .course-info .info-item:first-child::before,
    .course-card .course-info .info-item.level::before {
      content: "" !important;
      display: inline-block !important;
      width: 24px !important;
      height: 24px !important;
      background-size: contain !important;
      background-repeat: no-repeat !important;
      background-position: center !important;
      margin-bottom: 6px !important;
    }

    .learnsimply-courses-grid .course-info .info-item:first-child::before,
    .course-card .course-info .info-item:first-child::before {
      background-image: url("{{ theme_uri }}/assets/img/Inbox Line.png") !important;
    }

    .learnsimply-courses-grid .course-info .info-item.level::before,
    .course-card .course-info .info-item.level::before {
      background-image: url("{{ theme_uri }}/assets/img/levele.png") !important;
    }

    /* ── All-Courses Bundle Banner ──────────────────────────────── */
    .ls-bundle-banner {
      position: relative;
      overflow: hidden;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
      margin: 30px 0 45px;
      padding: 34px 38px;
      border-radius: 22px;
      border: 1px solid rgba(64, 119, 243, 0.35);
      background:
        radial-gradient(120% 160% at 100% 0%, rgba(64, 119, 243, 0.28) 0%, rgba(64, 119, 243, 0) 55%),
        radial-gradient(120% 160% at 0% 100%, rgba(255, 187, 84, 0.16) 0%, rgba(255, 187, 84, 0) 55%),
        linear-gradient(135deg, rgba(13, 20, 38, 0.96) 0%, rgba(10, 15, 26, 0.96) 100%);
      box-shadow: 0 20px 55px -25px rgba(64, 119, 243, 0.6);
    }
    .ls-bundle-banner__glow {
      position: absolute;
      inset: 0;
      background: radial-gradient(60% 120% at 85% 15%, rgba(64, 119, 243, 0.22) 0%, transparent 60%);
      pointer-events: none;
    }
    .ls-bundle-banner__content { position: relative; z-index: 1; flex: 1 1 420px; min-width: 260px; }
    .ls-bundle-banner__badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 14px;
      margin-bottom: 14px;
      border-radius: 999px;
      background: rgba(255, 187, 84, 0.14);
      border: 1px solid rgba(255, 187, 84, 0.4);
      color: #FFBB54;
      font-size: 13px;
      font-weight: 700;
    }
    .ls-bundle-banner__title {
      margin: 0 0 8px;
      color: #fff;
      font-size: 27px;
      font-weight: 800;
      line-height: 1.35;
    }
    .ls-bundle-banner__subtitle { margin: 0 0 18px; color: #B7BECF; font-size: 15px; line-height: 1.7; }
    .ls-bundle-banner__features {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 22px;
      margin-bottom: 22px;
    }
    .ls-bundle-banner__feature {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #E4E8F1;
      font-size: 14px;
      font-weight: 600;
    }
    .ls-bundle-banner__feature svg { flex-shrink: 0; }
    .ls-bundle-banner__price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; }
    .ls-bundle-banner__price-now { color: #fff; font-size: 30px; font-weight: 800; }
    .ls-bundle-banner__price-old { color: #7C8496; font-size: 18px; text-decoration: line-through; }
    .ls-bundle-banner__price-save {
      padding: 4px 12px;
      border-radius: 999px;
      background: rgba(46, 204, 113, 0.16);
      border: 1px solid rgba(46, 204, 113, 0.4);
      color: #43D787;
      font-size: 13px;
      font-weight: 700;
    }
    .ls-bundle-banner__cta { position: relative; z-index: 1; flex: 0 0 auto; }
    .ls-bundle-banner__btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 16px 34px;
      border-radius: 14px;
      background: linear-gradient(135deg, #4077F3 0%, #2E5BD8 100%);
      color: #fff;
      font-size: 16px;
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
      box-shadow: 0 14px 30px -10px rgba(64, 119, 243, 0.8);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .ls-bundle-banner__btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 40px -12px rgba(64, 119, 243, 0.95);
    }
    .ls-bundle-banner__btn svg { transition: transform 0.25s ease; }
    .ls-bundle-banner__btn:hover svg { transform: translateX(-4px); }
    @media (max-width: 768px) {
      .ls-bundle-banner { padding: 26px 22px; text-align: center; justify-content: center; }
      .ls-bundle-banner__title { font-size: 22px; }
      .ls-bundle-banner__features { justify-content: center; }
      .ls-bundle-banner__price { justify-content: center; }
      .ls-bundle-banner__cta { width: 100%; }
      .ls-bundle-banner__btn { width: 100%; justify-content: center; }
    }
  </style>
{% endblock %}

{% block main_attributes %}class="course-main-content"{% endblock %}

{% block content %}
  <div class="container">
    <!-- All-Courses Bundle Banner -->
    <div class="ls-bundle-banner">
      <div class="ls-bundle-banner__glow"></div>

      <div class="ls-bundle-banner__content">
        <span class="ls-bundle-banner__badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
            <path d="M12 2l2.9 6.26L21.9 9.27l-5 3.86L18 21l-6-3.16L6 21l1.1-7.87-5-3.86 6.99-0.99L12 2z" fill="#FFBB54"/>
          </svg>
          الأكثر قيمة
        </span>

        <h2 class="ls-bundle-banner__title">اشترك في باقة جميع الكورسات ووفّر أكتر</h2>
        <p class="ls-bundle-banner__subtitle">بدل ما تشتري كورس كورس، خُد رحلة البرمجة كاملة في باقة واحدة بسعر مميز ووصول مدى الحياة.</p>

        <div class="ls-bundle-banner__features">
          <span class="ls-bundle-banner__feature">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="#4077F3" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            6 كورسات كاملة
          </span>
          <span class="ls-bundle-banner__feature">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="#4077F3" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            422 درس
          </span>
          <span class="ls-bundle-banner__feature">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="#4077F3" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            وصول مدى الحياة
          </span>
        </div>

        <div class="ls-bundle-banner__price">
          <span class="ls-bundle-banner__price-now">2,500 جنيه مصري</span>
          <span class="ls-bundle-banner__price-old">4,800 جنيه</span>
          <span class="ls-bundle-banner__price-save">وفّر 2,300 جنيه · خصم 48%</span>
        </div>
      </div>

      <div class="ls-bundle-banner__cta">
        <a href="{{ site.url }}/course-bundle/allcourse/" class="ls-bundle-banner__btn">
          اشترك في الباقة الكاملة
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M12 19l-7-7 7-7" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>

    <!-- Archive Header -->
    <div class="learnsimply-section-container" style="margin-top: 30px; margin-bottom: 40px;">
      <div class="learnsimply-section-header">
      
        <h1 class="learnsimply-section-title">{{ archive_title }}</h1>
      </div>
    </div>

    <!-- Filter Section (Responsive) -->
    <div class="courses-filter-section" style="background: rgba(10, 15, 26, 0.8); border-radius: 20px; padding: 25px; border: 1px solid rgba(255, 255, 255, 0.1); margin-top: 40px; margin-bottom: 40px;">
      <h3 class="courses-filter-title" style="font-size: 20px; font-weight: 600; color: #fff; margin-bottom: 20px;">تصفية الدورات</h3>
      
      <!-- Search Box -->
      {% include 'components/search-box.twig' with {
        search_action: site.url ~ '/courses/',
        search_placeholder: 'ابحث عن دورة...',
        search_value: search_query|default(''),
        search_clear_url: site.url ~ '/courses/'
      } %}

      <!-- Categories Filter (Responsive) -->
      {% if course_categories and course_categories|length > 0 %}
      <div class="filter-categories-wrapper" style="display: flex; flex-wrap: wrap; gap: 10px;">
        <a 
          href="{{ site.url }}/courses/" 
          class="filter-category-btn {% if not current_course_category_slug %}active{% endif %}"
          style="display: inline-block; padding: 10px 20px; background: {% if not current_course_category_slug %}rgba(64, 119, 243, 0.2){% else %}rgba(255, 255, 255, 0.05){% endif %}; border: 1px solid {% if not current_course_category_slug %}rgba(64, 119, 243, 0.5){% else %}rgba(255, 255, 255, 0.1){% endif %}; border-radius: 8px; color: {% if not current_course_category_slug %}#4077F3{% else %}#999EB2{% endif %}; text-decoration: none; font-size: 14px; transition: all 0.3s ease; white-space: nowrap;"
          onmouseover="if(!this.classList.contains('active')) { this.style.background='rgba(255, 255, 255, 0.08)'; this.style.borderColor='rgba(255, 255, 255, 0.2)'; }"
          onmouseout="if(!this.classList.contains('active')) { this.style.background='rgba(255, 255, 255, 0.05)'; this.style.borderColor='rgba(255, 255, 255, 0.1)'; }"
        >
          كل الدورات
        </a>
        {% for cat in course_categories %}
          <a 
            href="{{ cat.link }}" 
            class="filter-category-btn {% if current_course_category_slug and current_course_category_slug == cat.slug %}active{% endif %}"
            style="display: inline-block; padding: 10px 20px; background: {% if current_course_category_slug and current_course_category_slug == cat.slug %}rgba(64, 119, 243, 0.2){% else %}rgba(255, 255, 255, 0.05){% endif %}; border: 1px solid {% if current_course_category_slug and current_course_category_slug == cat.slug %}rgba(64, 119, 243, 0.5){% else %}rgba(255, 255, 255, 0.1){% endif %}; border-radius: 8px; color: {% if current_course_category_slug and current_course_category_slug == cat.slug %}#4077F3{% else %}#999EB2{% endif %}; text-decoration: none; font-size: 14px; transition: all 0.3s ease; white-space: nowrap;"
            onmouseover="if(!this.classList.contains('active')) { this.style.background='rgba(255, 255, 255, 0.08)'; this.style.borderColor='rgba(255, 255, 255, 0.2)'; }"
            onmouseout="if(!this.classList.contains('active')) { this.style.background='rgba(255, 255, 255, 0.05)'; this.style.borderColor='rgba(255, 255, 255, 0.1)'; }"
          >
            {{ cat.name }} <span style="color: #666; font-size: 12px;">({{ cat.count }})</span>
          </a>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    <!-- Courses Grid (Full Width) -->
    {% if courses|length > 0 %}
    <div class="learnsimply-courses-grid" style="width: 100%;">
      {% for course in courses %}
      <article class="course-card">
        <!-- Course Image -->
        <div class="course-image">
          <a href="{{ course.link }}">
            <img src="{{ course.thumbnail }}" alt="{{ course.title }}" />
          </a>
        </div>

        <!-- Header: Badge + Instructor -->
        <div class="course-header">
          <div class="instructor-info">
            <div class="instructor-text">
              {% if course.instructor %}
                <p class="name">{{ course.instructor.display_name }}</p>
                <p class="title">{{ course.instructor.job_title|default(instructor_title) }}</p>
              {% else %}
                <p class="name">م. احمد عادل</p>
                <p class="title">{{ instructor_title }}</p>
              {% endif %}
            </div>

            <div class="instructor-avatar">
              <div class="avatar-glow avatar-glow-1"></div>
              <div class="avatar-glow avatar-glow-2"></div>
              {% if course.instructor and course.instructor.avatar %}
                <img src="{{ course.instructor.avatar }}" alt="Instructor" />
              {% else %}
                <img src="{{ theme_uri }}/assets/img/card_image.png" alt="Instructor" />
              {% endif %}
            </div>
          </div>

          <div class="course-badge">
            <p>كورس</p>
          </div>
        </div>

        <!-- Course Title -->
        <div class="course-title">
          <a href="{{ course.link }}" class="stretched-link"><p>{{ course.title }}</p></a>
        </div>

        <!-- Review and Students -->
        <div class="review-students">
          <div class="review">
            <svg class="star-icon" fill="none" viewBox="0 0 24 24">
              <path
                d="M12 2l2.9 6.26L21.9 9.27l-5 3.86L18 21l-6-3.16L6 21l1.1-7.87-5-3.86 6.99-0.99L12 2z"
                fill="#FFBB54"
              />
            </svg>
            <p>{{ course.rating_avg }} ({{ course.rating_count }} تقييم)</p>
          </div>

          <div class="students">
            <div class="students-avatars">
              <img
                class="student-avatar student-avatar-1"
                src="{{ theme_uri }}/assets/img/ellipse1.png"
                alt=""
              />
              <img
                class="student-avatar student-avatar-2"
                src="{{ theme_uri }}/assets/img/ellipse2.png"
                alt=""
              />
              <img
                class="student-avatar student-avatar-3"
                src="{{ theme_uri }}/assets/img/ellipse3.png"
                alt=""
              />

              <div class="student-count">
                <div class="student-count-circle">
                  <svg fill="none" viewBox="0 0 36.3884 36.9753">
                    <circle
                      cx="18"
                      cy="18"
                      r="16"
                      fill="#FFCE31"
                      stroke="white"
                      stroke-width="2"
                    />
                  </svg>
                </div>
                <p class="student-count-text">{{ course.students_count }}+</p>
              </div>
            </div>
            <p>الطلاب المشتركين</p>
          </div>
        </div>

        <!-- Course Info -->
        <div class="course-info">
          <div class="info-item">
            <svg class="info-icon" fill="none" viewBox="0 0 24 24">
              <path d="M3 7h18" stroke="#999EB2" stroke-width="1.5" />
              <path
                d="M4 19.5A2.5 2.5 0 016.5 17H20"
                stroke="#999EB2"
                stroke-width="1.5"
              />
            </svg>
            <p>{{ course.lesson_count }} محتوى</p>
          </div>

          <div class="info-divider">
            <svg fill="none" viewBox="0 0 32 1">
              <line
                stroke="white"
                stroke-opacity="0.05"
                x2="32"
                y1="0.5"
                y2="0.5"
              />
            </svg>
          </div>

          <div class="info-item level">
            <svg class="info-icon" fill="none" viewBox="0 0 24 24">
              <path
                d="M4 13l4-4 4 4 8-8"
                stroke="#999EB2"
                stroke-width="1.5"
              />
            </svg>
            <p>{{ course.level }}</p>
          </div>

          <div class="info-divider">
            <svg fill="none" viewBox="0 0 33 1">
              <line
                stroke="white"
                stroke-opacity="0.05"
                x2="33"
                y1="0.5"
                y2="0.5"
              />
            </svg>
          </div>

          <div class="info-item">
            <svg class="info-icon" fill="none" viewBox="0 0 24 24">
              <circle
                cx="12"
                cy="12"
                r="10"
                stroke="#999EB2"
                stroke-width="1.5"
              />
              <path
                d="M12 8V12L14.5 14.5"
                stroke="#999EB2"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <p>{{ course.duration|default('غير محدد') }}</p>
          </div>
        </div>

        <!-- Price Section -->
        <div class="price-section">
          {% if course.is_free %}
            <div class="price-display">
              <p class="new-price">مجاني</p>
            </div>
          {% elseif course.regular_price or course.sale_price %}
            {% if course.discount_percent > 0 %}
              <div class="discount-badge">
                <p>خصم {{ course.discount_percent }}%</p>
              </div>
            {% endif %}
            <div class="price-display">
              {% if course.regular_price and course.sale_price %}
                <p class="new-price">{{ course.sale_price|number_format(2, '.', ',') }} جنيه مصري</p>
                <p class="old-price">{{ course.regular_price|number_format(2, '.', ',') }} جنيه مصري</p>
              {% else %}
                <p class="new-price">{{ course.price|number_format(2, '.', ',') }} جنيه مصري</p>
              {% endif %}
            </div>
          {% else %}
            <div class="price-display">
              <p class="new-price">مجاني</p>
            </div>
          {% endif %}
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
          {% if course.is_enrolled %}
            <a
              href="{{ course.first_lesson_url }}"
              class="learnsimply-buy-now-button buy-button"
            >
              <span>ابدأ التعلم</span>
            </a>
          {% elseif course.is_free %}
            <a
              href="{{ course.link }}"
              class="learnsimply-buy-now-button buy-button"
            >
              <span>ابدأ التعلم</span>
            </a>
          {% else %}
            <a
              href="{{ course.link }}"
              class="details-button"
              aria-label="تفاصيل الكورس"
            >
              <span>تفاصيل</span>
            </a>
            {% if course.product_id %}
            <a
              href="{{ site.url }}/checkout/?add-to-cart={{ course.product_id }}"
              class="learnsimply-buy-now-button buy-button"
            >
              <span>ادفع الآن</span>
            </a>
            {% endif %}
          {% endif %}
        </div>
      </article>
      {% endfor %}
    </div>

    <!-- Pagination -->
    {% if pagination %}
    <div class="learnsimply-pagination" style="margin-top: 60px; margin-bottom: 60px; text-align: center; display: flex; justify-content: center; align-items: center; gap: 10px; flex-wrap: wrap;">
      {% if pagination.prev %}
        <a href="{{ pagination.prev.link }}" class="learnsimply-pagination-link learnsimply-pagination-prev" style="padding: 10px 20px; background: rgba(10, 15, 26, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: #fff; text-decoration: none; transition: all 0.3s ease;">
          السابق
        </a>
      {% endif %}
      
      {% for page in pagination.pages %}
        {% if page.link %}
          <a href="{{ page.link }}" class="learnsimply-pagination-link {% if page.current %}learnsimply-pagination-current{% endif %}" style="padding: 10px 15px; background: {% if page.current %}rgba(64, 119, 243, 0.2){% else %}rgba(10, 15, 26, 0.8){% endif %}; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: {% if page.current %}#4077F3{% else %}#fff{% endif %}; text-decoration: none; transition: all 0.3s ease; min-width: 40px; text-align: center;">
            {{ page.title }}
          </a>
        {% else %}
          <span class="learnsimply-pagination-link learnsimply-pagination-dots" style="padding: 10px 5px; color: #999EB2;">{{ page.title }}</span>
        {% endif %}
      {% endfor %}
      
      {% if pagination.next %}
        <a href="{{ pagination.next.link }}" class="learnsimply-pagination-link learnsimply-pagination-next" style="padding: 10px 20px; background: rgba(10, 15, 26, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: #fff; text-decoration: none; transition: all 0.3s ease;">
          التالي
        </a>
      {% endif %}
    </div>
    {% endif %}

    {% else %}
    <div class="learnsimply-no-courses" style="text-align: center; padding: 60px 20px;">
      <p style="font-size: 18px; color: #999EB2;">لا توجد دورات متاحة حالياً.</p>
    </div>
    {% endif %}
  </div>
{% endblock %}

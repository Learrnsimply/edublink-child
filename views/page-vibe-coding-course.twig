{% block scripts %}
<script>
(function () {
    /* ── Smooth scroll for step nav ── */
    document.querySelectorAll('a[href^="#lvc-step-"]').forEach(function (a) {
        a.addEventListener('click', function (e) {
            var target = document.querySelector(this.getAttribute('href'));
            if (target) {
                e.preventDefault();
                var offset = 80; // sticky nav height
                var top = target.getBoundingClientRect().top + window.pageYOffset - offset;
                window.scrollTo({ top: top, behavior: 'smooth' });
            }
        });
    });

    /* ── Highlight active step in nav while scrolling ── */
    var pills = document.querySelectorAll('.lvc-step-nav-pill');
    var steps = document.querySelectorAll('.lvc-step');
    if (pills.length && steps.length) {
        var obs = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    var n = entry.target.getAttribute('data-step');
                    pills.forEach(function (p) {
                        p.classList.toggle('is-active', p.getAttribute('data-step') === n);
                    });
                }
            });
        }, { rootMargin: '-30% 0px -60% 0px' });
        steps.forEach(function (s) { obs.observe(s); });
    }

    /* ── Copy-to-clipboard for tool links ── */
    document.querySelectorAll('.lvc-copy-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var url = this.getAttribute('data-copy');
            var textEl = this.querySelector('.lvc-copy-text');
            var fallback = function () {
                var ta = document.createElement('textarea');
                ta.value = url;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                try { document.execCommand('copy'); } catch (e) {}
                document.body.removeChild(ta);
            };
            var onSuccess = function () {
                btn.classList.add('is-copied');
                if (textEl) {
                    var prev = textEl.textContent;
                    textEl.textContent = 'تم النسخ ✓';
                    setTimeout(function () { btn.classList.remove('is-copied'); textEl.textContent = prev; }, 1800);
                }
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(url).then(onSuccess).catch(function () { fallback(); onSuccess(); });
            } else {
                fallback();
                onSuccess();
            }
        });
    });
})();
</script>
{% endblock %}

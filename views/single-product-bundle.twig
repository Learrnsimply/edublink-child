{% extends "layouts/base.twig" %}

{#
  صفحة الباقة — نفس لغة صفحة الكورس (assets/single-course/style.css عبر @import) + قسم
  «الكورسات جوه الباقة» مرتّب بالمستوى. ٩ كتل:
  هيرو ← الكورسات جوه الباقة ← عن الباقة ← هتتعلم إيه ← لمين ← وبعد الباقة ← الآراء + فورم
  ← الأسئلة ← CTA. كل الأرقام من ووكومرس وTutor وقت العرض.
#}

{% block body_class %}learnsimply-course-body lsc-body lsb-body{% endblock %}

{% block content %}
<div class="lsc lsb">

  {# ══ ١ · الهيرو ══ #}
  <section class="lsc-hero">
    <div class="lsc-wrap lsc-hero__grid">
      <div>
        <nav class="lsc-crumbs" aria-label="مسار التنقل">
          <a href="{{ site.url }}/courses/">الدورات</a>
          <span class="lsc-crumbs__sep">/</span><a href="{{ site.url }}/shop-2/?product_cat=bundle">الباقات</a>
          <span class="lsc-crumbs__sep">/</span>
          <span class="lsc-step lsb-step">باقة · {{ courses|length }} كورس{% if gifts|length > 0 %} + كتاب{% endif %}{% if positions|length > 0 and path_label %} · الخطوات {{ positions|join(' و') }} في {{ path_label }}{% endif %}</span>
        </nav>

        <h1 class="lsc-hero__title">{{ title }}</h1>
        {% if tagline %}<p class="lsc-hero__sub">{{ tagline }}</p>{% endif %}

        <div class="lsc-meta">
          {% if rating_count > 0 %}<span><span class="lsc-star">★</span> <b class="lsc-num">{{ rating_avg }}</b> <span class="lsc-num">({{ rating_count }} تقييم على الكورسات)</span></span>{% endif %}
          {% if students > 0 %}<span><b class="lsc-num">+{{ students|number_format(0, '.', ',') }}</b> طالب</span>{% endif %}
          {% if hours > 0 %}<span><b class="lsc-num">{{ hours }}</b> ساعة</span>{% endif %}
          {% if lessons > 0 %}<span><b class="lsc-num">{{ lessons }}</b> درس</span>{% endif %}
          {% for l in levels %}{% if not loop.first %}<span class="lsb-arrow">←</span>{% endif %}<span class="lsc-level lsc-level--{{ l == 'متوسط' ? 'intermediate' : (l == 'متقدم' ? 'expert' : 'beginner') }}">{{ l }}</span>{% endfor %}
        </div>

        <div class="lsc-hero__cta">
          {% if is_in_stock %}
            <a class="lsc-btn lsc-btn--primary lsc-btn--xl" href="{{ buy_url }}">امتلك الباقة {% if price_label %}<small class="lsc-num">· {{ price_label }} ج.م</small>{% endif %}</a>
          {% endif %}
          {% if reviews|length > 0 %}
            <a class="lsc-btn lsc-btn--rate" href="#reviews">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              شوف آراء الطلاب
            </a>
          {% endif %}
        </div>

        {% if save_label %}
          <p class="lsb-save"><span>الكورسات لوحدها <s class="lsc-num">{{ separate_label }} ج.م</s></span><b class="lsc-num">بتوفّر {{ save_label }} ج.م</b>{% if gifts|length > 0 %}<span>+ {{ gifts[0].title }} هدية</span>{% endif %}</p>
        {% endif %}
        <p class="lsc-guarantee">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          ضمان استرداد الفلوس خلال 7 أيام · وصول مدى الحياة بكل التحديثات
        </p>
      </div>
      <div class="lsc-media"><img src="{{ image }}" alt="{{ title }}" width="1024" height="576"></div>
    </div>
  </section>

  {# ══ ٢ · الكورسات جوه الباقة ══ #}
  {% if courses|length > 0 %}
  <section class="lsc-sec" id="inside" aria-labelledby="lsb-inside-title">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">Courses in this bundle</p>
      <h2 class="lsc-h2" id="lsb-inside-title">الكورسات جوه الباقة</h2>
      <p class="lsc-lead">{{ courses|length }} كورسات مرتّبة بالترتيب اللي تتعلم بيه. كل كورس بيبني على اللي قبله{% if gifts|length > 0 %}، والكتاب معاهم هدية{% endif %}.</p>
      <div class="lsb-inside">
        {% for c in courses %}
        <article class="lsb-icard">
          <span class="lsb-icard__n lsc-num">{{ loop.index }}</span>
          <a class="lsb-icard__img" href="{{ c.url }}" aria-hidden="true" tabindex="-1"><img src="{{ c.thumbnail }}" alt="" loading="lazy" width="360" height="203"></a>
          <div class="lsb-icard__body">
            <h3 class="lsb-icard__t"><a href="{{ c.url }}">{{ c.title }}</a></h3>
            {% if c.tagline %}<p class="lsb-icard__s">{{ c.tagline }}</p>{% endif %}
            <div class="lsb-icard__m">
              <span class="lsc-level lsc-level--{{ c.level_key }}">{{ c.level }}</span>
              {% if c.hours > 0 %}<span><b class="lsc-num">{{ c.hours }}</b> ساعة</span>{% endif %}
              <span><b class="lsc-num">{{ c.lesson_count }}</b> درس</span>
              {% if c.rating_count > 0 %}<span><span class="lsc-star">★</span> <b class="lsc-num">{{ c.rating_avg|number_format(1) }}</b> <span class="lsc-num">({{ c.rating_count }})</span></span>{% endif %}
            </div>
          </div>
          {% if c.price_label %}<div class="lsb-icard__price">لوحده<b class="lsc-num">{{ c.price_label }}</b>ج.م</div>{% endif %}
        </article>
        {% endfor %}
        {% for g in gifts %}
        <article class="lsb-icard lsb-icard--gift">
          <span class="lsb-icard__n" aria-hidden="true">🎁</span>
          <span class="lsb-icard__img lsb-icard__img--book"><img src="{{ g.image }}" alt="" loading="lazy" width="200" height="267"></span>
          <div class="lsb-icard__body">
            <span class="lsb-gift-tag">هدية مع الباقة</span>
            <h3 class="lsb-icard__t">{{ g.title }}</h3>
            {% if g.desc %}<p class="lsb-icard__s">{{ g.desc }}</p>{% endif %}
          </div>
          <div class="lsb-icard__price">لوحده<b class="lsc-num">0</b>مع الباقة</div>
        </article>
        {% endfor %}
      </div>
      <div class="lsb-sum">
        {% if hours > 0 %}<span><b class="lsc-num">{{ hours }}</b> ساعة فيديو</span>{% endif %}
        <span><b class="lsc-num">{{ lessons }}</b> درس</span>
        {% if students > 0 %}<span><b class="lsc-num">{{ students|number_format(0, '.', ',') }}</b> طالب في الكورسات</span>{% endif %}
        <span class="lsb-sum__ok">وصول مدى الحياة للكل</span>
      </div>
    </div>
  </section>
  {% endif %}

  {# ══ ٣ · عن الباقة ══ #}
  {% if about|length > 0 %}
  <section class="lsc-sec" aria-labelledby="lsb-about-title">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">About</p>
      <h2 class="lsc-h2" id="lsb-about-title">عن الباقة</h2>
      <div class="lsc-prose">{% for p in about %}<p>{{ p }}</p>{% endfor %}</div>
    </div>
  </section>
  {% endif %}

  {# ══ ٤ · هتتعلم إيه ══ #}
  {% set has_learn = false %}{% for c in courses %}{% if c.learn|length > 0 %}{% set has_learn = true %}{% endif %}{% endfor %}
  {% if has_learn %}
  <section class="lsc-sec" aria-labelledby="lsb-learn-title">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">What you'll learn</p>
      <h2 class="lsc-h2" id="lsb-learn-title">هتتعلم إيه في الباقة؟</h2>
      <div class="lsb-learn">
        {% for c in courses %}{% if c.learn|length > 0 %}
        <div class="lsb-lcol">
          <div class="lsb-lcol__h"><img src="{{ c.thumbnail }}" alt="" loading="lazy" width="64" height="36"><span><b>{{ loop.index }} · {{ c.label }}</b><small>{{ [c.hours > 0 ? c.hours ~ ' ساعة' : '', c.level, c.lesson_count ~ ' درس']|filter(v => v)|join(' · ') }}</small></span></div>
          {% for t in c.learn %}<div class="lsc-check">{% include 'components/icons/check.twig' %}<span>{{ t }}</span></div>{% endfor %}
        </div>
        {% endif %}{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ══ ٥ · لمين ══ #}
  {% if audience|length > 0 %}
  <section class="lsc-sec" aria-labelledby="lsb-who-title">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">Who is this for</p>
      <h2 class="lsc-h2" id="lsb-who-title">الباقة دي ليك لو…</h2>
      <div class="lsc-who">{% for t in audience %}<div class="lsc-who__item">{% include 'components/icons/check.twig' %}<span>{{ t }}</span></div>{% endfor %}</div>
    </div>
  </section>
  {% endif %}

  {# ══ ٦ · وبعد الباقة ══ #}
  {% if after|length > 0 or next_bundle %}
  <section class="lsc-sec" aria-labelledby="lsb-after-title">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">After the bundle</p>
      <h2 class="lsc-h2" id="lsb-after-title">وبعد الباقة؟</h2>
      {% if path_label %}<p class="lsc-lead">الكورسات اللي بتيجي بعد الباقة دي في {{ path_label }}، بالترتيب.</p>{% endif %}
      <div class="lsc-grid3">
        {% for s in after %}
        <article class="lsc-card">
          <a class="lsc-card__img" href="{{ s.url }}" aria-hidden="true" tabindex="-1"><img src="{{ s.thumbnail ?: no_image_url }}" alt="" loading="lazy" width="360" height="203"></a>
          <div class="lsc-card__body">
            <div class="lsc-card__row"><h3 class="lsc-card__t"><a href="{{ s.url }}">{{ s.label }}</a></h3>{% if s.hours_label %}<span class="lsc-hours lsc-num">{{ s.hours_label }}</span>{% endif %}</div>
            <span class="lsc-card__step">الخطوة اللي بعدها في المسار</span>
            <div class="lsc-card__meta"><span class="lsc-level lsc-level--{{ s.level_key }}">{{ s.level }}</span><span><span class="lsc-num">{{ s.lesson_count }}</span> درس</span>{% if s.price_label %}<span class="lsc-price"><span class="lsc-num">{{ s.price_label }}</span><small>ج.م</small></span>{% endif %}</div>
          </div>
        </article>
        {% endfor %}
        {% if next_bundle %}
        <article class="lsc-card lsb-card--bundle">
          <a class="lsc-card__img" href="{{ next_bundle.url }}" aria-hidden="true" tabindex="-1"><img src="{{ next_bundle.image ?: no_image_url }}" alt="" loading="lazy" width="360" height="203"></a>
          <div class="lsc-card__body">
            <div class="lsc-card__row"><h3 class="lsc-card__t"><a href="{{ next_bundle.url }}">{{ next_bundle.title }}</a></h3></div>
            <span class="lsc-card__step">الباقة اللي بعدها</span>
            <div class="lsc-card__meta"><span>باقة</span>{% if next_bundle.price_label %}<span class="lsc-price"><span class="lsc-num">{{ next_bundle.price_label }}</span><small>ج.م</small></span>{% endif %}</div>
          </div>
        </article>
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ══ ٧ · الآراء + فورم تقييم ووكومرس ══ #}
  {% if reviews|length > 0 or reviews_form %}
  <section class="lsc-sec" id="reviews" aria-labelledby="lsb-rev-title">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">Reviews</p>
      <h2 class="lsc-h2" id="lsb-rev-title">اللي جربوا قبلك قالوا إيه</h2>
      {% if rating_count > 0 %}<p class="lsc-lead"><span class="lsc-star">★</span> <b class="lsc-num lsc-lead__b">{{ rating_avg }}</b> من <span class="lsc-num">{{ rating_count }}</span> تقييم على كورسات الباقة، من طلاب اشتروا فعلًا.</p>{% endif %}
      {% if reviews|length > 0 %}
      <div class="lsc-reviews lsb-reviews">
        {% for r in reviews %}
        <figure class="lsc-rev" {% if loop.index > 4 %}hidden data-more{% endif %}>
          <div class="lsc-rev__stars" aria-label="{{ r.rating }} من 5">{% for i in 1..5 %}<span class="{{ i <= r.rating ? 'is-on' : '' }}">★</span>{% endfor %}</div>
          <blockquote class="lsc-rev__text">{{ r.content }}</blockquote>
          <figcaption class="lsc-rev__who">
            <span class="lsc-rev__av" aria-hidden="true">{{ r.author|slice(0, 1) }}</span>
            <span><b>{{ r.author }}</b><small>{{ r.date|date('d/m/Y') }}{% if r.pending %} · قيد المراجعة{% endif %}</small></span>
            {% if r.source %}<span class="lsb-rev__src">{{ r.source }}</span>{% endif %}
          </figcaption>
        </figure>
        {% endfor %}
      </div>
      {% if reviews|length > 4 %}<button type="button" class="lsc-link lsc-more" data-more-btn>كل الآراء ←</button>{% endif %}
      {% endif %}

      {% if reviews_form %}
      <div class="lsc-review-form add-review-section" id="add-review">
        <h3>شاركنا رأيك في الباقة</h3>
        {% if is_user_logged_in %}
          {{ reviews_form|safe_html }}
        {% else %}
          <p class="lsb-login-note">سجّل دخولك الأول عشان تقدر تكتب تقييم. <a class="lsc-link" href="{{ site.url }}/dashboard/">تسجيل الدخول ←</a></p>
        {% endif %}
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {# ══ ٨ · الأسئلة ══ #}
  {% if faq|length > 0 %}
  <section class="lsc-sec" aria-labelledby="lsb-faq-title">
    <div class="lsc-wrap">
      <p class="lsc-eyebrow">FAQ</p>
      <h2 class="lsc-h2" id="lsb-faq-title">أسئلة بتتسأل كتير</h2>
      <div class="lsc-faq">
        {% for f in faq %}
        <details class="lsc-faq__i" {% if loop.first %}open{% endif %}><summary class="lsc-faq__q">{{ f.q }}</summary><p class="lsc-faq__a">{{ f.a }}</p></details>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ══ ٩ · CTA ══ #}
  {% if is_in_stock and price_label %}
  <section class="lsc-cta" id="buy">
    <div class="lsc-wrap">
      <h2>الباقة كاملة، بسعر واحد</h2>
      <p>{{ names|join(' + ') }}{% for g in gifts %} + {{ g.title }}{% endfor %} · مرة واحدة · مدى الحياة</p>
      <div class="lsc-cta__price lsc-num">{{ price_label }} <small>ج.م</small></div>
      {% if save_label %}<p class="lsb-cta__save">بدل <s class="lsc-num">{{ separate_label }}</s> لو اشتريتهم لوحدهم · <b class="lsc-num">وفّر {{ save_label }} ج.م</b></p>{% endif %}
      <a class="lsc-btn lsc-btn--primary lsc-btn--xl" href="{{ buy_url }}">امتلك الباقة دلوقتي</a>
      <p class="lsc-guarantee lsc-guarantee--center">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        دفع آمن ببطاقتك أو محفظتك الإلكترونية · ضمان استرداد خلال 7 أيام
      </p>
    </div>
  </section>
  {% endif %}

</div>

{% if is_in_stock and price_label %}
<div class="lsc-sticky">
  <b class="lsc-num">{{ price_label }} <small>ج.م</small></b>
  <a class="lsc-btn lsc-btn--primary" href="{{ buy_url }}">امتلك الباقة</a>
</div>
{% endif %}
{% endblock %}
